# H7 Set A, job 4: file transform. Generated by gen_jobs.py -- do
# not hand-edit; rerun the generator instead.
#
# Planes has no `split`, so this program parses `id,name,qty,price`
# CSV text one code point at a time, tracking which of the four
# columns it is in. `write` always JSON-encodes its argument
# (interp.py's WriteTo: `payload = to_json(value.value)`), so the
# output file holds a JSON string, not raw CSV text -- the plain
# Python/JS versions write the same text unencoded, and the harness
# json-decodes this file before comparing.
use file

body = read "/tmp/planes_h7_bench/file_transform_input.csv"

field = ""
col = 0
id-f = ""
name-f = ""
qty-f = ""
price-f = ""
lines = []
row-count = 0

for each ch in body:
  if ch == "," or ch == "\n":
    if col == 0:
      id-f = field
    else:
      if col == 1:
        name-f = field
      else:
        if col == 2:
          qty-f = field
        else:
          price-f = field
    field = ""
    if ch == "\n":
      qty-n = number of qty-f
      price-n = number of price-f
      row-total = round (qty-n * price-n) to 2 places
      out-line = id-f + "," + (upper of name-f) + "," + qty-f + "," + price-f + "," + text of row-total + "\n"
      lines = lines plus out-line
      row-count = row-count + 1
      col = 0
    else:
      col = col + 1
  else:
    field = field + ch

document = join of lines
write document to "/tmp/planes_h7_bench/file_transform_output_planes.csv"
show "rows " + text of row-count
