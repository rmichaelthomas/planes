# H7 Set A, job 1: word count. Generated by gen_jobs.py -- do not
# hand-edit; rerun the generator instead.
#
# Planes has no dict and no range/repeat construct, so this program
# cannot build a frequency table or a word list the way the plain
# Python/JS versions do. It walks the file one code point at a time,
# accumulating the current word, and -- because the vocabulary is
# small and known -- bumps one named counter per word directly,
# the same shape corpus/histogram.planes uses for its three bands.
use file

body = read "/tmp/planes_h7_bench/word_count_input.txt"

current = ""
total = 0
c0 = 0
c1 = 0
c2 = 0
c3 = 0
c4 = 0
c5 = 0
c6 = 0
c7 = 0
c8 = 0
c9 = 0

for each ch in body:
  if ch == " " or ch == "\n":
    if current != "":
      total = total + 1
      if current == "the":
        c0 = c0 + 1
      else:
        if current == "fox":
          c1 = c1 + 1
        else:
          if current == "jumps":
            c2 = c2 + 1
          else:
            if current == "over":
              c3 = c3 + 1
            else:
              if current == "lazy":
                c4 = c4 + 1
              else:
                if current == "dog":
                  c5 = c5 + 1
                else:
                  if current == "quick":
                    c6 = c6 + 1
                  else:
                    if current == "brown":
                      c7 = c7 + 1
                    else:
                      if current == "river":
                        c8 = c8 + 1
                      else:
                        if current == "runs":
                          c9 = c9 + 1
    current = ""
  else:
    current = current + ch
if current != "":
  total = total + 1
  if current == "the":
    c0 = c0 + 1
  else:
    if current == "fox":
      c1 = c1 + 1
    else:
      if current == "jumps":
        c2 = c2 + 1
      else:
        if current == "over":
          c3 = c3 + 1
        else:
          if current == "lazy":
            c4 = c4 + 1
          else:
            if current == "dog":
              c5 = c5 + 1
            else:
              if current == "quick":
                c6 = c6 + 1
              else:
                if current == "brown":
                  c7 = c7 + 1
                else:
                  if current == "river":
                    c8 = c8 + 1
                  else:
                    if current == "runs":
                      c9 = c9 + 1

best = "the"
best-n = c0
if c1 > best-n:
  best = "fox"
  best-n = c1
if c2 > best-n:
  best = "jumps"
  best-n = c2
if c3 > best-n:
  best = "over"
  best-n = c3
if c4 > best-n:
  best = "lazy"
  best-n = c4
if c5 > best-n:
  best = "dog"
  best-n = c5
if c6 > best-n:
  best = "quick"
  best-n = c6
if c7 > best-n:
  best = "brown"
  best-n = c7
if c8 > best-n:
  best = "river"
  best-n = c8
if c9 > best-n:
  best = "runs"
  best-n = c9

show "total " + text of total
show "most " + best
show "count " + text of best-n
