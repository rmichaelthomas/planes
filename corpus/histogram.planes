# A histogram of scores in three bands. Rather than build a record and rewrite
# it each pass, three counters are carried down the list — one per band — which
# reads as exactly what it counts. The bar for each band is a string of marks,
# built by a small recursion.

to bar of n:
  if n <= 0:
    give ""
  else:
    give "#" + (bar of (n - 1))

scores = [12, 45, 78, 33, 91, 5, 66, 50, 88]

low = 0
mid = 0
high = 0
for each s in scores:
  if s < 33:
    low = low + 1
  else:
    if s < 66:
      mid = mid + 1
    else:
      high = high + 1

show "  0-32  " + (bar of low)
show " 33-65  " + (bar of mid)
show " 66-99  " + (bar of high)

let choice = "one counter per band" because "three plain counters read as what they count; a record rebuilt on every pass would bury the counting under the bookkeeping"
show choice
