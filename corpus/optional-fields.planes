# Optional fields, handled honestly. A profile may or may not carry a phone
# number. Rather than invent a blank one, `when` reads the record's shape: the
# `{ phone }` pattern binds that field into the branch, and it only matches when
# the field is actually there. A profile without it falls to `else` and is
# treated as a genuine absence — `nothing` — which the caller then handles on
# purpose.

profiles = [
  { name: "Ada", phone: "555-0100" },
  { name: "Alan" }
]

to phone-number of profile:
  when profile is { phone }:
    give phone
  else:
    give nothing

for each p in profiles:
  let found = phone-number of p
  if found is nothing:
    show p.name + ": no phone on file"
  else:
    show p.name + ": " + found

let stance = "a blank number and no number mean different things" because "nothing keeps an absent field distinct from an empty one, so a caller never mistakes 'unknown' for 'known to be blank'"
show stance
