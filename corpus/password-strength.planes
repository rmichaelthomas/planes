# Score a password's strength from its length and whether it mixes cases. Length
# carries most of the weight; a capital somewhere lifts a long one to strong. The
# rules are a plain ladder, so a reader sees exactly what earns each rating.

to strength of password:
  let size = count of password
  let has-capital = not (lower of password == password)
  if size >= 12 and has-capital:
    give "strong"
  else:
    if size >= 8:
      give "fair"
    else:
      give "weak"

candidates = ["hunter2", "correcthorsebattery", "Tr0ub4dour"]

for each p in candidates:
  show p + ": " + (strength of p)

let cheap-test = "lower of a password differing from itself means a capital is present" because "it is a one-line test for at least one upper-case letter, which raw length alone never guarantees"
show cheap-test
