rule [no-external-sends] anything may not ask
  because "default-deny keeps audit events from leaking to an unapproved endpoint"
rule [audit-allowed] anything may ask to "https://audit.internal" supersedes [no-external-sends]
  because "the internal audit collector is the one approved exception"

note:
  from "SOC 2 CC7.2 change-management control"
  derives-from [audit-allowed]

use http

to main:
  show "sending audit event"
  ask "https://audit.internal"

main
