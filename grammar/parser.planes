note: from "parser.py, written in Planes -- Route B stage two. Turns grammar/lexer.planes's token stream into an AST that agrees with parser.py's, checked by test_parser_in_planes.py's canonical-AST-text comparison harness. Amber (the four disambiguation sites) is explicitly out of scope -- Build 5."

use lexer
use vocabulary

# ================================================================ string escaping, for the canonical form
#
# planes_text.escape_string_literal's Planes twin: a string value,
# re-escaped as the content of a Planes STRING literal (quote, backslash,
# newline, tab) so a leaf value survives round-trip through the
# canonical text form the same way it would through re-parsed source.
# Character-by-character via for each -- a host-language loop, so this
# costs zero Planes-level recursion regardless of string length, the
# same shape lexer.planes's own step functions already use.

to escape-char of c:
  if c == "\"":
    give "\\\""
  else:
    if c == "\\":
      give "\\\\"
    else:
      if c == "\n":
        give "\\n"
      else:
        if c == "\t":
          give "\\t"
        else:
          give c

to escape-string-literal of s:
  result = ""
  for each c in s:
    result = result + escape-char of c
  give result

to render-string of s:
  give "\"" + (escape-string-literal of s) + "\""

to render-bool of b:
  if b:
    give "true"
  else:
    give "false"

# ================================================================ number-literal text, parsed by hand
#
# Number.parse (planes_num.py) has no Planes-side equivalent, and none of
# the 8 builtins converts text to a number -- `whole` truncates an
# EXISTING number, it does not parse one. Rather than spend a 9th builtin
# on this (declined on the same grounds `chr of n` was, REPORT_STRING_
# ESCAPES.md's ruling: a magic conversion builtin reintroduces exactly
# the opacity the closed vocabulary exists to avoid), a NUMBER token's
# text is parsed digit by digit, the same character-by-character idiom
# is-digit/is-alpha already use for classification -- built entirely from
# already-proven capabilities (comparison, arithmetic, for each), not a
# language change. Whole and fractional parts both accumulate as exact
# integers; the fractional part becomes value/10^digits via ordinary `/`,
# matching Number's own exact-rational semantics for a decimal literal.

to digit-value of c:
  digits = "0123456789"
  result = 0 - 1
  i = 0
  for each d in digits:
    if d == c:
      result = i
    i = i + 1
  if result == (0 - 1):
    fail "not a digit: '" + c + "'" as parse-error
  else:
    give result

to parse-number-step of state, c:
  if c == ".":
    give { whole-part: state.whole-part, frac-part: state.frac-part, frac-divisor: state.frac-divisor, seen-dot: true }
  else:
    d = digit-value of c
    if state.seen-dot:
      new-frac = state.frac-part * 10 + d
      new-divisor = state.frac-divisor * 10
      give { whole-part: state.whole-part, frac-part: new-frac, frac-divisor: new-divisor, seen-dot: true }
    else:
      new-whole = state.whole-part * 10 + d
      give { whole-part: new-whole, frac-part: state.frac-part, frac-divisor: state.frac-divisor, seen-dot: false }

to parse-number-text of raw:
  initial = { whole-part: 0, frac-part: 0, frac-divisor: 1, seen-dot: false }
  result = initial
  for each c in raw:
    result = parse-number-step of result, c
  if result.seen-dot:
    give result.whole-part + (result.frac-part / result.frac-divisor)
  else:
    give result.whole-part

# ================================================================ STRING token text, quotes stripped
#
# A STRING token's text already carries escape-resolved content between
# two literal quote characters (lexer.planes's step-string, matching
# lexer.py's own token.value exactly -- REPORT_STRING_ESCAPES.md's
# ruling 1). parser.py strips them with `.value[1:-1]`; Planes has no
# slice syntax (#11) and no "drop first/last" for a string, so this walks
# every character once, counting position, and keeps everything except
# position 0 and the last position -- the same counted-fold idiom
# leading-whitespace-count already uses in lexer.planes, not indexing.

to strip-quotes-step of state, c:
  is-first = state.i == 0
  is-last = state.i == (state.n - 1)
  new-result = state.result
  keep = not (is-first or is-last)
  if keep:
    new-result = state.result + c
  give { result: new-result, i: (state.i + 1), n: state.n }

to strip-quotes of s:
  n = count of s
  initial = { result: "", i: 0, n: n }
  result = initial
  for each c in s:
    result = strip-quotes-step of result, c
  give result.result

# ================================================================ the canonical form
#
# One node per line, indentation for depth, node kind then its fields in
# parser.py's own dataclass declaration order -- test_parser_in_planes.py
# renders the Python side the same way, generically, by introspecting
# lexer.py's dataclasses; this side is hand-written per node kind because
# Planes has no way to enumerate a record's fields (no builtin for it,
# and none is being added -- section 7 invariant 1). `indent` is threaded
# as a literal string, grown by "  " per recursive level, rather than a
# depth number -- one fewer arithmetic op per level, and it is what the
# recursive call sites read directly.

to join-with-newlines of lines:
  result = ""
  seen-one = false
  for each line in lines:
    if seen-one:
      result = result + "\n" + line
    else:
      result = line
      seen-one = true
  give result

# The body of a `field: [N]` list of AST nodes -- just the "- \n <node>"
# blocks, newline-joined; "" for an empty list. The caller composes the
# "fieldname: [N]" header itself, since the field name and count vary
# per call site and this function has no way to know either generically
# (same reason canonical-of-node is hand-dispatched, not introspected).
to canonical-of-node-list of items, indent:
  lines = []
  for each item in items:
    entry = indent + "-\n" + (canonical-of-node of item, (indent + "  "))
    lines = lines plus entry
  give join-with-newlines of lines

to canonical-of-call of node, indent:
  header = indent + "Call\n" + indent + "  name: " + (render-string of node.name)
  n = count of node.args
  with-header = header + "\n" + indent + "  args: [" + (text of n) + "]"
  result = with-header
  if n > 0:
    body = canonical-of-node-list of node.args, (indent + "    ")
    result = with-header + "\n" + body
  give result + "\n" + indent + "  line: " + (text of node.line)

# A `field: [N]` list header plus its body -- every list-valued AST field
# (Call.args above, If.then/els here, and every later rung's block-body
# fields) shares this exact two-line-or-more shape; only the field name
# and the items differ per call site.
to canonical-of-field-list of field-name, items, indent:
  n = count of items
  header = indent + "  " + field-name + ": [" + (text of n) + "]"
  if n > 0:
    body = canonical-of-node-list of items, (indent + "    ")
    give header + "\n" + body
  else:
    give header

to canonical-of-if of node, indent:
  cond-part = canonical-of-node of node.cond, (indent + "    ")
  header = indent + "If\n" + indent + "  cond:\n" + cond-part
  then-part = canonical-of-field-list of "then", node.then, indent
  els-part = canonical-of-field-list of "els", node.els, indent
  give header + "\n" + then-part + "\n" + els-part

# A field whose list items are plain strings (FuncDef.params), not AST
# nodes -- "- value" on one line, matching the Python side's
# _render_list_item for anything that isn't a node.
to canonical-of-string-field-list of field-name, items, indent:
  n = count of items
  header = indent + "  " + field-name + ": [" + (text of n) + "]"
  if n > 0:
    item-indent = indent + "    "
    lines = []
    for each item in items:
      lines = lines plus (item-indent + "- " + (render-string of item))
    give header + "\n" + (join-with-newlines of lines)
  else:
    give header

to canonical-of-funcdef of node, indent:
  header = indent + "FuncDef\n" + indent + "  name: " + (render-string of node.name)
  params-part = canonical-of-string-field-list of "params", node.params, indent
  body-part = canonical-of-field-list of "body", node.body, indent
  give header + "\n" + params-part + "\n" + body-part

to canonical-of-where of node, indent:
  if node.where is nothing:
    give indent + "  where: nothing"
  else:
    where-node-part = canonical-of-node of node.where, (indent + "    ")
    give indent + "  where:\n" + where-node-part

to canonical-of-foreach of node, indent:
  source-part = canonical-of-node of node.source, (indent + "    ")
  header = indent + "ForEach\n" + indent + "  var: " + (render-string of node.var)
  with-source = header + "\n" + indent + "  source:\n" + source-part
  where-part = canonical-of-where of node, indent
  with-where = with-source + "\n" + where-part
  body-part = canonical-of-field-list of "body", node.body, indent
  with-body = with-where + "\n" + body-part
  give with-body + "\n" + indent + "  is_expr: " + (render-bool of node.is-expr)

# Use.renames is a list of (old, new) name pairs -- Python-tuple-shaped
# on parser.py's side, but Planes has no tuple literal syntax, only
# records and lists (#11's scope again), so each pair is a plain
# { old, new } record here. Not an AST node (no `kind`), so this can't
# reuse canonical-of-node-list -- rendered directly to match the Python
# side's own pair rendering for a non-node 2-tuple: "(old, new)".
to canonical-of-renames of renames, indent:
  n = count of renames
  header = indent + "  renames: [" + (text of n) + "]"
  if n > 0:
    item-indent = indent + "    "
    lines = []
    for each r in renames:
      pair-text = "(" + (render-string of r.old) + ", " + (render-string of r.new) + ")"
      lines = lines plus (item-indent + "- " + pair-text)
    give header + "\n" + (join-with-newlines of lines)
  else:
    give header

to canonical-of-use of node, indent:
  header = indent + "Use\n" + indent + "  module: " + (render-string of node.module)
  renames-part = canonical-of-renames of node.renames, indent
  give header + "\n" + renames-part

to canonical-of-listlit of node, indent:
  header = indent + "ListLit"
  give header + "\n" + (canonical-of-field-list of "items", node.items, indent)

# RecordLit.fields is a list of (name, expr) pairs on parser.py's side --
# each one a plain { key, value } record here (no tuple syntax, #11,
# same as Use.renames), rendered to match the Python side's own
# (str, node)-pair item shape: `- "key":` then the value node indented
# one more level, not canonical-of-node-list's bare `-` (that shape is
# for plain node items, with no key to print).
to canonical-of-record-fields of fields, indent:
  n = count of fields
  header = indent + "  fields: [" + (text of n) + "]"
  if n > 0:
    item-indent = indent + "    "
    lines = []
    for each f in fields:
      key-line = item-indent + "- " + (render-string of f.key) + ":"
      value-part = canonical-of-node of f.value, (item-indent + "  ")
      lines = lines plus (key-line + "\n" + value-part)
    give header + "\n" + (join-with-newlines of lines)
  else:
    give header

to canonical-of-recordlit of node, indent:
  give indent + "RecordLit\n" + (canonical-of-record-fields of node.fields, indent)

# ---- canonical forms for the statement/declaration nodes past the ladder
# (S3a Phase 4). Each matches test_parser_in_planes.py's now-fully-
# structural canonical form: every AST node kind expands field by field
# rather than any node being rendered by a Python dataclass repr.

to canonical-of-annotation of ann, indent:
  # the trailing `annotation` on an Assign or Rule: `nothing`, or an
  # expanded Because { text, line } (a plain record -- Because carries no
  # `kind` and is never dispatched by canonical-of-node).
  if ann is nothing:
    give indent + "  annotation: nothing"
  else:
    with-text = indent + "  annotation:\n" + indent + "    Because\n" + indent + "      text: " + (render-string of ann.text)
    give with-text + "\n" + indent + "      line: " + (text of ann.line)

to canonical-of-writeto of node, indent:
  value-part = canonical-of-node of node.value, (indent + "    ")
  dest-part = canonical-of-node of node.dest, (indent + "    ")
  header = indent + "WriteTo\n" + indent + "  value:\n" + value-part
  with-dest = header + "\n" + indent + "  dest:\n" + dest-part
  give with-dest + "\n" + indent + "  line: " + (text of node.line)

to canonical-of-why of node, indent:
  inner = canonical-of-node of node.expr, (indent + "    ")
  give indent + "Why\n" + indent + "  expr:\n" + inner

to canonical-of-fail of node, indent:
  msg-part = canonical-of-node of node.message, (indent + "    ")
  header = indent + "Fail\n" + indent + "  message:\n" + msg-part
  with-tag = header + "\n" + indent + "  tag: " + (render-string of node.tag)
  give with-tag + "\n" + indent + "  line: " + (text of node.line)

to canonical-of-recordupdate of node, indent:
  base-part = canonical-of-node of node.base, (indent + "    ")
  header = indent + "RecordUpdate\n" + indent + "  base:\n" + base-part
  fields-part = canonical-of-record-fields of node.fields, indent
  give header + "\n" + fields-part

to canonical-of-orfail of node, indent:
  expr-part = canonical-of-node of node.expr, (indent + "    ")
  header = indent + "OrFail\n" + indent + "  expr:\n" + expr-part
  with-tag = header + "\n" + indent + "  tag: " + (render-string of node.tag)
  if node.handler is nothing:
    give with-tag + "\n" + indent + "  handler: nothing"
  else:
    give with-tag + "\n" + (canonical-of-field-list of "handler", node.handler, indent)

to canonical-of-pattern-entry of entry, indent:
  if entry.matcher-tag == "match":
    node-part = canonical-of-node of entry.value, (indent + "  ")
    give indent + "- " + (render-string of entry.field) + " match:\n" + node-part
  else:
    give indent + "- " + (render-string of entry.field) + " bind: " + (render-string of entry.value)

to canonical-of-when-pattern of pattern, indent:
  n = count of pattern
  header = indent + "  pattern: [" + (text of n) + "]"
  if n > 0:
    item-indent = indent + "    "
    lines = []
    for each entry in pattern:
      lines = lines plus (canonical-of-pattern-entry of entry, item-indent)
    give header + "\n" + (join-with-newlines of lines)
  else:
    give header

to canonical-of-when of node, indent:
  subject-part = canonical-of-node of node.subject, (indent + "    ")
  header = indent + "When\n" + indent + "  subject:\n" + subject-part
  pattern-part = canonical-of-when-pattern of node.pattern, indent
  with-pattern = header + "\n" + pattern-part
  body-part = canonical-of-field-list of "body", node.body, indent
  with-body = with-pattern + "\n" + body-part
  els-part = canonical-of-field-list of "els", node.els, indent
  give with-body + "\n" + els-part

to canonical-of-optional-field of field-name, value, indent:
  # a `nothing`-or-string field (Rule.target / .supersedes / .fingerprint).
  if value is nothing:
    give indent + "  " + field-name + ": nothing"
  else:
    give indent + "  " + field-name + ": " + (render-string of value)

to canonical-of-rule of node, indent:
  header = indent + "Rule\n" + indent + "  name: " + (render-string of node.name)
  with-subject = header + "\n" + indent + "  subject: " + (render-string of node.subject)
  with-kind = with-subject + "\n" + indent + "  kind: " + (render-string of node.rule-kind)
  with-target = with-kind + "\n" + (canonical-of-optional-field of "target", node.target, indent)
  with-line = with-target + "\n" + indent + "  line: " + (text of node.line)
  with-sup = with-line + "\n" + (canonical-of-optional-field of "supersedes", node.supersedes, indent)
  with-assert = with-sup + "\n" + indent + "  assertion: " + (render-string of node.assertion)
  with-fp = with-assert + "\n" + (canonical-of-optional-field of "supersedes_fingerprint", node.supersedes-fingerprint, indent)
  give with-fp + "\n" + (canonical-of-annotation of node.annotation, indent)

to canonical-of-effect-item of effect, indent:
  if effect.target-tag == "literal":
    give indent + "- " + (render-string of effect.kind) + " literal: " + (render-string of effect.target-value)
  else:
    if effect.target-tag == "param":
      give indent + "- " + (render-string of effect.kind) + " param: " + (render-string of effect.target-value)
    else:
      give indent + "- (" + (render-string of effect.kind) + ", nothing)"

to canonical-of-effects of effects, indent:
  n = count of effects
  header = indent + "  effects: [" + (text of n) + "]"
  if n > 0:
    item-indent = indent + "    "
    lines = []
    for each e in effects:
      lines = lines plus (canonical-of-effect-item of e, item-indent)
    give header + "\n" + (join-with-newlines of lines)
  else:
    give header

to canonical-of-foreign of node, indent:
  header = indent + "Foreign\n" + indent + "  name: " + (render-string of node.name)
  params-part = canonical-of-string-field-list of "params", node.params, indent
  with-params = header + "\n" + params-part
  with-target = with-params + "\n" + indent + "  target: " + (render-string of node.target)
  effects-part = canonical-of-effects of node.effects, indent
  with-effects = with-target + "\n" + effects-part
  with-declared = with-effects + "\n" + indent + "  declared: " + (render-bool of node.declared)
  give with-declared + "\n" + indent + "  line: " + (text of node.line)

to canonical-of-note-entry of entry, indent:
  give indent + "- (" + (render-string of entry.kind) + ", " + (render-string of entry.value) + ")"

to canonical-of-note of node, indent:
  n = count of node.entries
  header = indent + "Note\n" + indent + "  entries: [" + (text of n) + "]"
  if n > 0:
    item-indent = indent + "    "
    lines = []
    for each e in node.entries:
      lines = lines plus (canonical-of-note-entry of e, item-indent)
    with-entries = header + "\n" + (join-with-newlines of lines)
  else:
    with-entries = header
  give with-entries + "\n" + indent + "  line: " + (text of node.line)

# Flat dispatch: a sequence of `if node.kind == "X": ... give` statements,
# each falling through to the next when it does not match. This replaces a
# ~22-level-deep when/else chain whose nesting made canonical-of-node itself
# too deep for the parser to walk when parsing this very file (self-parsing,
# S3a Phase 4, ruling A.6: a recursion-too-deep is a design bug in the code,
# fixed here, not a ceiling to raise) -- and it drops the per-dispatch frames
# the nested form also spent at run time. Every field access stays statically
# named, so shapes.py still sees which fields are read.
to canonical-of-node of node, indent:
  k = node.kind
  if k == "Num":
    give indent + "Num\n" + indent + "  value: " + text of node.value
  if k == "Str":
    give indent + "Str\n" + indent + "  value: " + render-string of node.value
  if k == "Bool":
    give indent + "Bool\n" + indent + "  value: " + render-bool of node.value
  if k == "Nothing":
    give indent + "Nothing"
  if k == "Var":
    give indent + "Var\n" + indent + "  name: " + render-string of node.name
  if k == "BinOp":
    left-part = canonical-of-node of node.left, (indent + "    ")
    right-part = canonical-of-node of node.right, (indent + "    ")
    header = indent + "BinOp\n" + indent + "  op: " + render-string of node.op
    with-left = header + "\n" + indent + "  left:\n" + left-part
    give with-left + "\n" + indent + "  right:\n" + right-part
  if k == "ListPlus":
    base-part = canonical-of-node of node.base, (indent + "    ")
    item-part = canonical-of-node of node.item, (indent + "    ")
    header = indent + "ListPlus\n" + indent + "  base:\n" + base-part
    give header + "\n" + indent + "  item:\n" + item-part
  if k == "Not":
    inner = canonical-of-node of node.expr, (indent + "    ")
    give indent + "Not\n" + indent + "  expr:\n" + inner
  if k == "IsNothing":
    inner = canonical-of-node of node.expr, (indent + "    ")
    give indent + "IsNothing\n" + indent + "  expr:\n" + inner
  if k == "Field":
    obj-part = canonical-of-node of node.obj, (indent + "    ")
    header = indent + "Field\n" + indent + "  obj:\n" + obj-part
    give header + "\n" + indent + "  name: " + (render-string of node.name)
  if k == "Round":
    value-part = canonical-of-node of node.value, (indent + "    ")
    places-part = canonical-of-node of node.places-value, (indent + "    ")
    header = indent + "Round\n" + indent + "  value:\n" + value-part
    give header + "\n" + indent + "  places:\n" + places-part
  if k == "Call":
    give canonical-of-call of node, indent
  if k == "Assign":
    expr-part = canonical-of-node of node.expr, (indent + "    ")
    header = indent + "Assign\n" + indent + "  name: " + (render-string of node.name)
    with-expr = header + "\n" + indent + "  expr:\n" + expr-part
    with-let = with-expr + "\n" + indent + "  is_let: " + (render-bool of node.is-let)
    give with-let + "\n" + (canonical-of-annotation of node.annotation, indent)
  if k == "Show":
    expr-part = canonical-of-node of node.expr, (indent + "    ")
    header = indent + "Show\n" + indent + "  expr:\n" + expr-part
    give header + "\n" + indent + "  line: " + (text of node.line)
  if k == "If":
    give canonical-of-if of node, indent
  if k == "FuncDef":
    give canonical-of-funcdef of node, indent
  if k == "Give":
    inner = canonical-of-node of node.expr, (indent + "    ")
    give indent + "Give\n" + indent + "  expr:\n" + inner
  if k == "ForEach":
    give canonical-of-foreach of node, indent
  if k == "Use":
    give canonical-of-use of node, indent
  if k == "ListLit":
    give canonical-of-listlit of node, indent
  if k == "RecordLit":
    give canonical-of-recordlit of node, indent
  if k == "WriteTo":
    give canonical-of-writeto of node, indent
  if k == "Why":
    give canonical-of-why of node, indent
  if k == "Fail":
    give canonical-of-fail of node, indent
  if k == "RecordUpdate":
    give canonical-of-recordupdate of node, indent
  if k == "OrFail":
    give canonical-of-orfail of node, indent
  if k == "When":
    give canonical-of-when of node, indent
  if k == "Rule":
    give canonical-of-rule of node, indent
  if k == "Foreign":
    give canonical-of-foreign of node, indent
  if k == "Note":
    give canonical-of-note of node, indent
  fail "no canonical form for node kind '" + k + "'" as unknown-node-kind

# ================================================================ the cursor
#
# A cursor is the remaining token list -- nothing more (S3a ruling A.1).
# `rest of xs` (S2) is the advance, so the cons-list machinery that used
# to stand in for it -- to-cons / reverse-into / unreverse -- retires
# entirely. It existed only to give a forward-walking handle back when no
# `rest` builtin existed, and its per-token `unreverse` recursion was the
# construction ceiling every long file hit (one frame per token: 140 deep
# before S2, 245 after, and status_threading.planes at 577 tokens still
# hit it). With `rest`, cursor construction costs zero Planes-level
# recursion at any file length. `advance` clamps at the final token (the
# EOF the tokenizer always appends) so a peek past the end returns EOF --
# exactly as parser.py's own peek() clamps -- which also means `rest` is
# never called on an empty list (`rest of []` raises, S2 A.3).

to current of cursor:
  # the first remaining token; `first 1 of` yields a one-element list,
  # unwrapped by a single for-each pass (one iteration, no recursion).
  result = nothing
  for each t in (first 1 of cursor):
    result = t
  give result

to advance of cursor:
  remaining = rest of cursor
  if count of remaining == 0:
    give cursor
  else:
    give remaining

to peek-at of cursor, k:
  if k == 0:
    give current of cursor
  else:
    give peek-at of (advance of cursor), (k - 1)

# ================================================================ the name table (known_funcs)
#
# parser.py carries known_funcs as ambient class state (Parser.known_funcs,
# set once by parse()); Planes has no globals, so the same table is built
# once at the entry point and threaded as `known` alongside the cursor
# (A.1 keeps the cursor the plain token list, so `known` cannot ride
# inside it). The table is the association idiom (A.2): a LIST of
# { name, arity } records, scanned with `for each ... where`. No dynamic
# record lookup (r[k]) -- every field access below is statically named, so
# shapes.py can still see which fields a program reads, which is the
# soundness reason a name table is expressible this way and r[k] was not.

# The 10 builtins, each arity 1 -- parser.py's
# {b["name"]: b.get("arity", 1) for b in _VOCAB["builtins"]}, and every
# builtin defaults to 1 (none declares another). `builtins` comes from
# grammar/vocabulary.planes via `use vocabulary`, the same single source
# of truth lexer.planes reads, so this never drifts from the locked 10.
to builtin-entries:
  result = []
  for each b in builtins:
    result = result plus { name: b, arity: 1 }
  give result

# A `to` starts a definition only when it begins a statement -- the token
# before it is a line/block boundary, or it is the very first token
# (parser.py: i == 0 or tokens[i-1].kind in (EOL, BEGIN, END)). "START" is
# the sentinel prev-kind for the first token.
to prev-allows-def of prev-kind:
  is-start = prev-kind == "START"
  is-boundary = prev-kind == "EOL" or prev-kind == "BEGIN" or prev-kind == "END"
  give is-start or is-boundary

# Comma-separated NAME parameters after `of` -- parser.py's _param_arity.
# The cursor points at the first parameter (the token after `of`); 0 when
# there is no NAME there at all. Bounded by the parameter count, a handful.
to count-params-more of cursor, n:
  is-comma = tok-at-value of cursor, "OP", ","
  next-is-name = (peek-at of cursor, 1).kind == "NAME"
  if is-comma and next-is-name:
    give count-params-more of (advance of (advance of cursor)), (n + 1)
  else:
    give n

to count-params of cursor:
  if tok-at of cursor, "NAME":
    give count-params-more of (advance of cursor), 1
  else:
    give 0

# The name and arity of one `to`/`foreign` declaration -- the cursor points
# just after the `to`/`foreign` keyword. { has-name, name, arity }. A bare
# `of` never occurs, so arity is 0 exactly when there is no `of` clause.
to decl-name-arity of cursor:
  name-result = collect-name-parts of cursor, []
  parts = name-result.parts
  if count of parts == 0:
    give { has-name: false, name: "", arity: 0 }
  else:
    name = join-with-spaces of parts
    after-name = name-result.cursor
    if tok-at of after-name, "OF":
      arity = count-params of (advance of after-name)
      give { has-name: true, name: name, arity: arity }
    else:
      give { has-name: true, name: name, arity: 0 }

# prescan_funcs (parser.py): one forward pass over every token, acting only
# at TO/FOREIGN tokens, tracking the previous token's kind so a `to` that
# opens `write x to "path"` is not mistaken for a definition. Iterative
# over the whole list (capability 4: a for-each pass costs zero Planes-level
# recursion regardless of length) -- `tokens` drives the loop purely as a
# safe upper bound; the real position rides in state.cursor. The sub-scan
# for each name/arity is local (from the token after the keyword) and never
# moves the main cursor, exactly as parser.py's inner `j` is local to `i`.
to prescan-step of state, ignored-token:
  if state.done:
    give state
  else:
    t = current of state.cursor
    if t.kind == "EOF":
      give { table: state.table, cursor: state.cursor, prev-kind: "EOF", done: true }
    else:
      new-table = state.table
      if t.kind == "FOREIGN":
        info = decl-name-arity of (advance of state.cursor)
        if info.has-name:
          new-table = state.table plus { name: info.name, arity: info.arity }
        else:
          new-table = state.table
      else:
        is-def = t.kind == "TO" and (prev-allows-def of state.prev-kind)
        if is-def:
          info = decl-name-arity of (advance of state.cursor)
          if info.has-name:
            new-table = state.table plus { name: info.name, arity: info.arity }
          else:
            new-table = state.table
        else:
          new-table = state.table
      give { table: new-table, cursor: (advance of state.cursor), prev-kind: t.kind, done: false }

to run-prescan of state, tokens:
  result = state
  for each tok in tokens:
    result = prescan-step of result, tok
  give result

to prescan-funcs of tokens:
  initial = { table: [], cursor: tokens, prev-kind: "START", done: false }
  final = run-prescan of initial, tokens
  give final.table

# builtins first, prescan appended -- lookup-func returns the LAST match, so
# a user function shadows a builtin of the same name, exactly as parser.py's
# merged.update(prescan) overwrites the builtins map (parse() docstring).
# The harness parses each file standalone, so cross-file `known` is empty on
# both sides; only builtins + this file's own prescan populate the table.
to append-all of base, more:
  result = base
  for each x in more:
    result = result plus x
  give result

to build-known of tokens:
  prescanned = prescan-funcs of tokens
  give append-all of (builtin-entries), prescanned

# A lookup is one for-each over the table; the `where` keeps only matching
# entries and the last one wins (append order = insertion order = parser.py
# dict order). { found, arity }; arity is `nothing` only when a name is
# present with unknown arity (cross-file `known` set-form -- never reached
# through the standalone-file parsing this harness does, but represented
# faithfully so the amber sites' unknown-arity branches are ports, not
# stubs).
to lookup-func of known, name:
  result = { found: false, arity: nothing }
  for each entry in known where entry.name == name:
    result = { found: true, arity: entry.arity }
  give result

to is-known-func of known, name:
  give (lookup-func of known, name).found

# ================================================================ amber (the four refusal sites)
#
# parser.py refuses -- it does not guess -- whenever the name table admits
# more than one viable parse (addendum v4.2 section 69.5). The refusal text
# is rendered to match parser.py's render_amber byte for byte (A.3: one
# refusal style, not two), so test_amber_in_planes.py can assert the two
# implementations produce the SAME message on the same ambiguous fragment.
# parser.py reads the templates from grammar/messages/amber.json (ruling
# D5, "no message text inline in parser.py"); that ruling scopes parser.py,
# and Planes cannot read a JSON file without an effect, so the fixed
# template text is reproduced here as ordinary string literals -- the same
# way this file already reproduces parser.py's inline ordinary-error text.

# 0 -> "A", 1 -> "B", ... one letter per candidate reading (chr(ord("A")+i)
# in render_amber). Eight covers any realistic multiword overlap; a reading
# past that degrades to "?" rather than failing (never reached in practice).
to letter-of of i:
  letters = ["A", "B", "C", "D", "E", "F", "G", "H"]
  result = "?"
  j = 0
  for each L in letters:
    if j == i:
      result = L
    j = j + 1
  give result

# `  reading {letter}:  {source}\n              {gloss}` -- amber.json's
# `readings` template, identical across every amber message.
to render-one-reading of letter, reading:
  give "  reading " + letter + ":  " + reading.source + "\n              " + reading.gloss

to nth-reading of readings, i:
  result = nothing
  j = 0
  for each r in readings:
    if j == i:
      result = r
    j = j + 1
  give result

to render-readings-from of readings, i, acc, seen:
  n = count of readings
  if i >= n:
    give acc
  else:
    reading = nth-reading of readings, i
    line = render-one-reading of (letter-of of i), reading
    if seen:
      give render-readings-from of readings, (i + 1), (acc + "\n" + line), true
    else:
      give render-readings-from of readings, (i + 1), line, true

# render_amber's join: headline, blank, the readings (each two lines),
# blank, reason, fix. The caller passes headline/reason/fix already
# substituted, since it holds the per-site slot values.
to assemble-amber of headline, readings, reason, fix:
  readings-text = render-readings-from of readings, 0, "", false
  give headline + "\n\n" + readings-text + "\n\n" + reason + "\n" + fix

# ", ".join(labels[:-1]) + ", and " + labels[-1], with the 1- and 2-label
# special cases render_amber's raise_amber_multiword uses for `names_txt`.
to first-item of xs:
  result = nothing
  for each x in (first 1 of xs):
    result = x
  give result

to last-item of xs:
  result = nothing
  for each x in xs:
    result = x
  give result

to join-comma of items:
  result = ""
  seen = false
  for each x in items:
    if seen:
      result = result + ", " + x
    else:
      result = x
      seen = true
  give result

to join-labels of labels:
  n = count of labels
  if n == 1:
    give last-item of labels
  else:
    if n == 2:
      give (first-item of labels) + " and " + (last-item of labels)
    else:
      head-part = join-comma of (first (n - 1) of labels)
      give head-part + ", and " + (last-item of labels)

# parser.py's _peek_text / _peek_trailer: a best-effort source
# reconstruction for an amber message (not a claim about original spacing).
# _peek_text joins token text (its kind when the text is empty, i.e. a
# boundary token) from offset `start` to `end`; _peek_trailer takes up to
# four tokens from `offset`, stopping at a statement boundary.
to peek-text-from of cursor, k, endpos, acc, seen:
  if k >= endpos:
    give acc
  else:
    tok = peek-at of cursor, k
    piece = tok.text
    if piece == "":
      piece = tok.kind
    if seen:
      give peek-text-from of cursor, (k + 1), endpos, (acc + " " + piece), true
    else:
      give peek-text-from of cursor, (k + 1), endpos, piece, true

to peek-text of cursor, start, endpos:
  give peek-text-from of cursor, start, endpos, "", false

to peek-trailer-loop of cursor, offset, endpos, i:
  if i == 4:
    give peek-text of cursor, offset, endpos
  else:
    tok = peek-at of cursor, (offset + i)
    is-boundary = tok.kind == "EOL" or tok.kind == "EOF" or tok.kind == "END" or tok.kind == "BEGIN"
    if is-boundary:
      give peek-text of cursor, offset, endpos
    else:
      new-end = offset + i + 1
      is-stmt-sep = tok.kind == "OP" and (tok.text == ":" or tok.text == ";")
      if is-stmt-sep:
        give peek-text of cursor, offset, new-end
      else:
        give peek-trailer-loop of cursor, offset, new-end, (i + 1)

to peek-trailer of cursor, offset:
  give peek-trailer-loop of cursor, offset, offset, 0

# ---- the four refusal sites, each a faithful port of parser.py's raise_*
# / check_* pair. Amber refuses `as ambiguity`; the message is the assembled
# amber text, equal to parser.py's render_amber output on the same fragment.

# Site 1 (parser.py:parse_primary multi-word longest match) --
# raise_amber_multiword. `after-name` is the cursor just past the head name,
# where parser.py's own self.peek(0) sits when it raises, so peek-trailer
# reads the same tokens. bare-hit contributes reading A when the head name
# is itself a known function; each ext-hit { k, probe } contributes one.
to build-ext-readings of ext-hits, after-name, readings0, labels0:
  acc = { readings: readings0, labels: labels0 }
  for each hit in ext-hits:
    trailer = peek-trailer of after-name, hit.k
    if trailer == "":
      source = hit.probe
    else:
      source = hit.probe + "  " + trailer
    reading = { source: source, gloss: "one call to `" + hit.probe + "`" }
    label = "`" + hit.probe + "`"
    acc = { readings: (acc.readings plus reading), labels: (acc.labels plus label) }
  give acc

to raise-amber-multiword of line, name, bare-hit, ext-hits, after-name:
  base-readings = []
  base-labels = []
  if bare-hit:
    trailer0 = peek-trailer of after-name, 0
    if trailer0 == "":
      source0 = name
    else:
      source0 = name + "  then  " + trailer0
    reading0 = { source: source0, gloss: "the value `" + name + "`, then whatever parses next on its own" }
    base-readings = [reading0]
    base-labels = ["`" + name + "`"]
  built = build-ext-readings of ext-hits, after-name, base-readings, base-labels
  names-txt = join-labels of built.labels
  if count of ext-hits > 0:
    last-hit = last-item of ext-hits
    suggestion = "(" + last-hit.probe + ")"
  else:
    suggestion = "(" + name + ")"
  headline = "line " + (text of line) + ": two readings are possible here, and nothing says which"
  reason = "both " + names-txt + " are defined, so the parser will not choose between them"
  fix = "try: parenthesise the one you mean -- `" + suggestion + "` -- or rename one of the functions so only one reading is possible"
  msg = assemble-amber of headline, built.readings, reason, fix
  fail msg as ambiguity

# Site 2 (parser.py:parse_primary takes_arg) -- raise_amber_juxtaposition /
# _unknown, and check_juxtaposition_ambiguity's decision. after-name points
# at the following NAME (parser.py's self.peek()).
to raise-amber-juxtaposition of line, head, next-name:
  r0 = { source: head + " (" + next-name + ")", gloss: "one call to `" + head + "`, passing the result of calling `" + next-name + "`" }
  r1 = { source: head + "  then  " + next-name, gloss: "`" + head + "` with no argument, then a separate call to `" + next-name + "`" }
  headline = "line " + (text of line) + ": `" + head + " " + next-name + "` reads two ways, and nothing says which"
  reason = "`" + head + "` takes an argument and `" + next-name + "` is also a defined function, so the parser will not choose between them"
  fix = "try: `" + head + " (" + next-name + ")` to call `" + next-name + "` first and pass its result to `" + head + "` -- or write them as two separate statements if you meant them apart"
  msg = assemble-amber of headline, [r0, r1], reason, fix
  fail msg as ambiguity

to raise-amber-juxtaposition-unknown of line, subject:
  r0 = { source: subject + "(...)", gloss: "if `" + subject + "` takes an argument here, one call using what follows" }
  r1 = { source: subject + "  then  ...", gloss: "if `" + subject + "` takes no argument here, a separate statement follows" }
  headline = "line " + (text of line) + ": whether `" + subject + "` takes an argument here is not known"
  reason = "the arity of `" + subject + "` is not known here"
  fix = "declare it, or call it with `of` so the argument is explicit"
  msg = assemble-amber of headline, [r0, r1], reason, fix
  fail msg as ambiguity

# Returns whether the following NAME is consumed as the argument; fails when
# both readings fit. Only called when `name` is known and a NAME follows.
to check-juxtaposition-ambiguity of known, name, after-name, line:
  look = lookup-func of known, name
  if look.arity is nothing:
    give raise-amber-juxtaposition-unknown of line, name
  else:
    if look.arity == 0:
      give false
    else:
      next-name = (current of after-name).text
      next-look = lookup-func of known, next-name
      if not next-look.found:
        give true
      else:
        if next-look.arity is nothing:
          give raise-amber-juxtaposition-unknown of line, next-name
        else:
          if next-look.arity == 0:
            give raise-amber-juxtaposition of line, name, next-name
          else:
            give true

# Site 3 (parser.py:paren_is_arglist) -- check_paren_arglist_ambiguity.
# `paren-cursor` points at the `(`; close/paren-src/rest-src are computed
# unconditionally, as parser.py does. Fails when arity is 1 (both readings
# fit) or unknown; a sentinel record otherwise (parser.py returns None and
# the caller parses the single-argument call).
to matching-close-paren-offset of cursor, k, depth:
  tok = peek-at of cursor, k
  if tok.kind == "EOF":
    give k + 1
  else:
    if tok.kind == "OP" and tok.text == "(":
      give matching-close-paren-offset of cursor, (k + 1), (depth + 1)
    else:
      if tok.kind == "OP" and tok.text == ")":
        new-depth = depth - 1
        if new-depth == 0:
          give k + 1
        else:
          give matching-close-paren-offset of cursor, (k + 1), new-depth
      else:
        give matching-close-paren-offset of cursor, (k + 1), depth

# str.strip() for the paren-arglist sources -- only leading/trailing space
# can appear (the sources are built by concatenation with single spaces, no
# tabs/newlines). `rest`/index are list-only (S2 A.3), so both trims walk the
# string with for-each, which iterates code points and costs no recursion.
to strip-leading-space of s:
  result = ""
  started = false
  for each c in s:
    keep = started or (not (c == " "))
    if keep:
      result = result + c
      started = true
  give result

to last-char-of of s, n:
  result = ""
  i = 0
  for each c in s:
    if i == (n - 1):
      result = c
    i = i + 1
  give result

to all-but-last-char of s, n:
  result = ""
  i = 0
  for each c in s:
    if i < (n - 1):
      result = result + c
    i = i + 1
  give result

to strip-trailing-space of s:
  n = count of s
  if n == 0:
    give s
  else:
    if (last-char-of of s, n) == " ":
      give strip-trailing-space of (all-but-last-char of s, n)
    else:
      give s

to strip-both-spaces of s:
  give strip-trailing-space of (strip-leading-space of s)

to check-paren-arglist-ambiguity of known, name, paren-cursor, line:
  look = lookup-func of known, name
  close = matching-close-paren-offset of paren-cursor, 0, 0
  paren-src = peek-text of paren-cursor, 1, (close - 1)
  rest-src = peek-trailer of paren-cursor, close
  if look.arity is nothing:
    r0 = { source: name + "(" + paren-src + ")", gloss: "if `" + name + "` takes one argument here, this call alone" }
    r1src = strip-both-spaces of (name + "(" + paren-src + ") " + rest-src)
    r1 = { source: r1src, gloss: "if not, the whole expression including what follows" }
    headline = "line " + (text of line) + ": whether `" + name + "` takes one argument here is not known"
    reason = "the arity of `" + name + "` is not known here"
    fix = "declare it, or call it with `of` so the argument is explicit"
    msg = assemble-amber of headline, [r0, r1], reason, fix
    fail msg as ambiguity
  else:
    if look.arity == 1:
      s0 = strip-both-spaces of (name + "(" + paren-src + ") " + rest-src)
      r0 = { source: s0, gloss: "one call to `" + name + "`, argument = everything up to and including `" + rest-src + "`" }
      s1 = strip-both-spaces of ("(" + name + "(" + paren-src + ")) " + rest-src)
      r1 = { source: s1, gloss: "one call to `" + name + "`, argument = `" + paren-src + "` alone; `" + rest-src + "` applies to the call's result, not inside it" }
      headline = "line " + (text of line) + ": two readings are possible here, and nothing says which"
      reason = "`" + name + "` takes exactly one argument, so both readings have the right shape"
      fix = "try: `" + name + "(" + paren-src + ")` with nothing after the parens on this call, or restructure so `" + name + "` clearly applies to just one thing"
      msg = assemble-amber of headline, [r0, r1], reason, fix
      fail msg as ambiguity
    else:
      give { checked: true }

# Site 4 (parser.py:parse_statement USE rename clause) --
# check_rename_name_ambiguity. `parts` is the `old` name already split into
# words (read-multiword-name keeps them), so no string split is needed.
# Every prefix parts[:k] is checked against the table; two or more matches
# means the greedy full read was not the only viable one.
to rename-hits of known, parts, k, maxk, acc:
  if k > maxk:
    give acc
  else:
    prefix = join-with-spaces of (first (k) of parts)
    if is-known-func of known, prefix:
      give rename-hits of known, parts, (k + 1), maxk, (acc plus k)
    else:
      give rename-hits of known, parts, (k + 1), maxk, acc

to drop-n of xs, k:
  if k == 0:
    give xs
  else:
    give drop-n of (rest of xs), (k - 1)

to build-rename-readings of parts, hits:
  result = []
  for each k in hits:
    prefix = join-with-spaces of (first (k) of parts)
    rest-text = join-with-spaces of (drop-n of parts, k)
    if rest-text == "":
      gloss = "`" + prefix + "` alone"
      source = prefix
    else:
      gloss = "`" + prefix + "`, leaving `" + rest-text + "` unaccounted for"
      source = prefix + " | " + rest-text
    result = result plus { source: source, gloss: gloss }
  give result

to check-rename-name-ambiguity of known, parts, name, line:
  maxk = count of parts
  hits = rename-hits of known, parts, 1, maxk, []
  if count of hits < 2:
    give { checked: true }
  else:
    readings = build-rename-readings of parts, hits
    headline = "line " + (text of line) + ": `" + name + "` reads two ways, and nothing says which"
    reason = "more than one exported name matches this text, so the parser will not choose between them"
    fix = "try: rename to match only one exported name exactly -- a shorter or longer phrase"
    msg = assemble-amber of headline, readings, reason, fix
    fail msg as ambiguity

to tok-at of cursor, kind:
  t = current of cursor
  give t.kind == kind

to tok-at-value of cursor, kind, value:
  t = current of cursor
  give t.kind == kind and t.text == value

to try-accept of cursor, kind:
  if tok-at of cursor, kind:
    give { matched: true, token: (current of cursor), cursor: (advance of cursor) }
  else:
    give { matched: false, token: (current of cursor), cursor: cursor }

to try-accept-value of cursor, kind, value:
  if tok-at-value of cursor, kind, value:
    give { matched: true, token: (current of cursor), cursor: (advance of cursor) }
  else:
    give { matched: false, token: (current of cursor), cursor: cursor }

to expect-kind of cursor, kind:
  if tok-at of cursor, kind:
    give { token: (current of cursor), cursor: (advance of cursor) }
  else:
    t = current of cursor
    fail "line " + (text of t.line) + ": expected " + kind + ", found '" + t.text + "'" as parse-error

to expect-op of cursor, value:
  if tok-at-value of cursor, "OP", value:
    give { token: (current of cursor), cursor: (advance of cursor) }
  else:
    t = current of cursor
    fail "line " + (text of t.line) + ": expected '" + value + "', found '" + t.text + "'" as parse-error

# ================================================================ paren-is-arglist lookahead
#
# parser.py's own lookahead, not amber (amber is Build 5, out of scope --
# section 7 invariant 3): scan to the matching close paren; an operator
# right after it means the parens were a sub-expression, not the whole
# argument list. Recurses once per token between the parens -- bounded
# by one call's argument-list size, not file length.

to is-additive-or-comparison-op of txt:
  group-a = txt == "+" or txt == "-" or txt == "*" or txt == "/"
  group-b = txt == "<" or txt == ">" or txt == "<=" or txt == ">=" or txt == "==" or txt == "!="
  give group-a or group-b

to scan-to-matching-paren of cursor, depth:
  t = current of cursor
  if t.kind == "EOF":
    give cursor
  else:
    if t.kind == "OP" and t.text == "(":
      give scan-to-matching-paren of (advance of cursor), (depth + 1)
    else:
      if t.kind == "OP" and t.text == ")":
        new-depth = depth - 1
        if new-depth == 0:
          give advance of cursor
        else:
          give scan-to-matching-paren of (advance of cursor), new-depth
      else:
        give scan-to-matching-paren of (advance of cursor), depth

to paren-is-arglist of cursor:
  after-close = scan-to-matching-paren of (advance of cursor), 1
  t = current of after-close
  if t.kind == "OP" and (is-additive-or-comparison-op of t.text):
    give false
  else:
    give true

# ================================================================ the expression precedence chain
#
# parser.py's own levels, read directly from parser.py (not inferred
# from this prompt or PROBE_PARSER.md's illustrative example -- section
# 0 step 5): parse_or -> parse_and -> parse_not -> parse_comparison ->
# parse_plus -> parse_additive -> parse_multiplicative -> parse_unary ->
# parse_postfix -> parse_primary. `known` (the name table) is threaded
# through every level down to parse-primary, where juxtaposition and
# multi-word calls are resolved and the amber sites refuse (parser.py
# reaches the same table as ambient class state -- Planes has no globals).
# Every parse function returns { node, cursor }, mirroring capability 3's
# proven { node, index } shape with `cursor` (the remaining token list,
# A.1) standing in for the index.

to parse-call-of-args of cursor, known:
  first-arg = parse-unary of cursor, known
  give collect-of-args of first-arg.cursor, [first-arg.node], known

to collect-of-args of cursor, acc, known:
  comma = try-accept-value of cursor, "OP", ","
  if comma.matched:
    next-arg = parse-unary of comma.cursor, known
    give collect-of-args of next-arg.cursor, (acc plus next-arg.node), known
  else:
    give { nodes: acc, cursor: cursor }

to parse-call-paren-args of cursor, known:
  first-arg = parse-expr of cursor, known
  give collect-paren-args of first-arg.cursor, [first-arg.node], known

to collect-paren-args of cursor, acc, known:
  comma = try-accept-value of cursor, "OP", ","
  if comma.matched:
    next-arg = parse-expr of comma.cursor, known
    give collect-paren-args of next-arg.cursor, (acc plus next-arg.node), known
  else:
    give { nodes: acc, cursor: cursor }

# parser.py's parse_primary NAME branch, in order: an `of` call, a `(`
# argument list (or a parenthesised single argument -- site 3), a
# multi-word longest match (site 1), a juxtaposition single-argument call
# (site 2), and finally a plain variable.
to parse-name-primary of t, cursor, known:
  name = t.text
  line = t.line
  after-name = advance of cursor
  of-try = try-accept of after-name, "OF"
  if of-try.matched:
    args = parse-call-of-args of of-try.cursor, known
    give { node: { kind: "Call", name: name, args: args.nodes, line: line }, cursor: args.cursor }
  else:
    at-paren = tok-at-value of after-name, "OP", "("
    if at-paren:
      give parse-name-paren-call of name, line, after-name, known
    else:
      if tok-at of after-name, "NAME":
        give parse-name-multiword of name, line, after-name, known
      else:
        give parse-name-juxtaposition of name, line, after-name, known

# Site 1: every k whose joined text `name w1 ... wk` is a known function,
# plus the bare name itself, is a candidate reading; two or more means the
# parser refuses (raise_amber_multiword) rather than silently preferring
# one. With fewer than two, the single extension (if any) is consumed.
to collect-ext-hits of known, probe, cursor, k, acc:
  t = current of cursor
  if t.kind == "NAME":
    new-probe = probe + " " + t.text
    new-k = k + 1
    if is-known-func of known, new-probe:
      new-acc = acc plus { k: new-k, probe: new-probe }
    else:
      new-acc = acc
    give collect-ext-hits of known, new-probe, (advance of cursor), new-k, new-acc
  else:
    give acc

to advance-n of cursor, j:
  if j == 0:
    give cursor
  else:
    give advance-n of (advance of cursor), (j - 1)

to parse-name-multiword of name, line, after-name, known:
  ext-hits = collect-ext-hits of known, name, after-name, 0, []
  bare-hit = is-known-func of known, name
  if bare-hit:
    bare-count = 1
  else:
    bare-count = 0
  total = bare-count + (count of ext-hits)
  if total >= 2:
    give raise-amber-multiword of line, name, bare-hit, ext-hits, after-name
  else:
    if count of ext-hits > 0:
      hit = first-item of ext-hits
      consumed = advance-n of after-name, hit.k
      of-try = try-accept of consumed, "OF"
      if of-try.matched:
        args = parse-call-of-args of of-try.cursor, known
        give { node: { kind: "Call", name: hit.probe, args: args.nodes, line: line }, cursor: args.cursor }
      else:
        give { node: { kind: "Call", name: hit.probe, args: [], line: line }, cursor: consumed }
    else:
      give parse-name-juxtaposition of name, line, after-name, known

# Site 2: a known function may take one argument by juxtaposition
# (`ask url`, `ask "https://" + text of id`). A following NAME only counts
# as the argument when it is not itself the start of a call the parser
# cannot choose against (check-juxtaposition-ambiguity).
to parse-name-juxtaposition of name, line, after-name, known:
  if is-known-func of known, name:
    nt = current of after-name
    takes-arg = nt.kind == "STRING" or nt.kind == "NUMBER" or (nt.kind == "OP" and nt.text == "(") or (nt.kind == "OP" and nt.text == "[")
    if (not takes-arg) and (nt.kind == "NAME"):
      takes-arg = check-juxtaposition-ambiguity of known, name, after-name, line
    if takes-arg:
      arg = parse-additive of after-name, known
      give { node: { kind: "Call", name: name, args: [arg.node], line: line }, cursor: arg.cursor }
    else:
      give { node: { kind: "Call", name: name, args: [], line: line }, cursor: after-name }
  else:
    give { node: { kind: "Var", name: name }, cursor: after-name }

to parse-name-paren-call of name, line, cursor, known:
  is-arglist = paren-is-arglist of cursor
  if is-arglist:
    give parse-name-real-arglist of name, line, cursor, known
  else:
    # site 3: guard refuses when both readings fit; otherwise the single
    # parenthesised argument is parsed (parse-additive, as parser.py).
    guard = check-paren-arglist-ambiguity of known, name, cursor, line
    single = parse-additive of cursor, known
    give { node: { kind: "Call", name: name, args: [single.node], line: line }, cursor: single.cursor }

to parse-name-real-arglist of name, line, cursor, known:
  open-consumed = advance of cursor
  at-close = tok-at-value of open-consumed, "OP", ")"
  if at-close:
    give { node: { kind: "Call", name: name, args: [], line: line }, cursor: (advance of open-consumed) }
  else:
    args = parse-call-paren-args of open-consumed, known
    closed = expect-op of args.cursor, ")"
    give { node: { kind: "Call", name: name, args: args.nodes, line: line }, cursor: closed.cursor }

# `[` / `{` primaries: list and record literals. skip-bracket-ws mirrors
# parser.py's own (EOL/`;`/BEGIN/END all transparent inside brackets --
# a literal spanning indented lines picks up indentation tokens that
# mean nothing here, since the brackets already carry the structure);
# bounded by how many blank/dedent tokens sit between two literal
# elements, not file size.

to skip-bracket-ws of cursor:
  t = current of cursor
  is-blank-here = t.kind == "EOL" or t.kind == "BEGIN" or t.kind == "END" or (t.kind == "OP" and t.text == ";")
  if is-blank-here:
    give skip-bracket-ws of (advance of cursor)
  else:
    give cursor

to collect-list-items of cursor, acc, known:
  after-ws = skip-bracket-ws of cursor
  comma = try-accept-value of after-ws, "OP", ","
  if comma.matched:
    after-comma-ws = skip-bracket-ws of comma.cursor
    if tok-at-value of after-comma-ws, "OP", "]":
      give { items: acc, cursor: after-comma-ws }
    else:
      next-result = parse-expr of after-comma-ws, known
      give collect-list-items of next-result.cursor, (acc plus next-result.node), known
  else:
    give { items: acc, cursor: after-ws }

to parse-list-literal of cursor, known:
  after-open = skip-bracket-ws of (advance of cursor)
  if tok-at-value of after-open, "OP", "]":
    give { node: { kind: "ListLit", items: [] }, cursor: (advance of after-open) }
  else:
    first-result = parse-expr of after-open, known
    remaining = collect-list-items of first-result.cursor, [first-result.node], known
    closed = expect-op of remaining.cursor, "]"
    give { node: { kind: "ListLit", items: remaining.items }, cursor: closed.cursor }

to parse-record-field of cursor, known:
  after-ws = skip-bracket-ws of cursor
  t = current of after-ws
  if is-field-name-kind of t.kind:
    colon-expect = expect-op of (advance of after-ws), ":"
    value-result = parse-expr of colon-expect.cursor, known
    give { key: t.text, value: value-result.node, cursor: value-result.cursor }
  else:
    fail "line " + (text of t.line) + ": expected a field name, found '" + t.text + "'" as parse-error

to collect-record-fields of cursor, acc, known:
  after-ws = skip-bracket-ws of cursor
  comma = try-accept-value of after-ws, "OP", ","
  if comma.matched:
    after-comma-ws = skip-bracket-ws of comma.cursor
    if tok-at-value of after-comma-ws, "OP", "}":
      give { fields: acc, cursor: after-comma-ws }
    else:
      next = parse-record-field of after-comma-ws, known
      give collect-record-fields of next.cursor, (acc plus { key: next.key, value: next.value }), known
  else:
    give { fields: acc, cursor: after-ws }

to parse-record-literal of cursor, known:
  after-open = skip-bracket-ws of (advance of cursor)
  if tok-at-value of after-open, "OP", "}":
    give { node: { kind: "RecordLit", fields: [] }, cursor: (advance of after-open) }
  else:
    first-field = parse-record-field of after-open, known
    remaining = collect-record-fields of first-field.cursor, [{ key: first-field.key, value: first-field.value }], known
    closed = expect-op of remaining.cursor, "}"
    give { node: { kind: "RecordLit", fields: remaining.fields }, cursor: closed.cursor }

to parse-primary of cursor, known:
  t = current of cursor
  k = t.kind
  if k == "FIRST":
    after-first = advance of cursor
    n-result = parse-unary of after-first, known
    of-expect = expect-kind of n-result.cursor, "OF"
    x-result = parse-unary of of-expect.cursor, known
    node = { kind: "BinOp", op: "first", left: n-result.node, right: x-result.node }
    give { node: node, cursor: x-result.cursor }
  if k == "ROUND":
    after-round = advance of cursor
    value-result = parse-unary of after-round, known
    to-expect = expect-kind of value-result.cursor, "TO"
    places-result = parse-unary of to-expect.cursor, known
    places-try = try-accept of places-result.cursor, "PLACES"
    node = { kind: "Round", value: value-result.node, places-value: places-result.node }
    give { node: node, cursor: places-try.cursor }
  if k == "NUMBER":
    n = parse-number-text of t.text
    give { node: { kind: "Num", value: n }, cursor: (advance of cursor) }
  if k == "STRING":
    s = strip-quotes of t.text
    give { node: { kind: "Str", value: s }, cursor: (advance of cursor) }
  if k == "TRUE":
    give { node: { kind: "Bool", value: true }, cursor: (advance of cursor) }
  if k == "FALSE":
    give { node: { kind: "Bool", value: false }, cursor: (advance of cursor) }
  if k == "NOTHING":
    give { node: { kind: "Nothing" }, cursor: (advance of cursor) }
  if k == "FOR":
    give parse-foreach-expr of cursor, known
  if k == "NAME":
    give parse-name-primary of t, cursor, known
  if k == "OP" and t.text == "{":
    give parse-record-literal of cursor, known
  if k == "OP" and t.text == "[":
    give parse-list-literal of cursor, known
  if k == "OP" and t.text == "(":
    inner = parse-expr of (advance of cursor), known
    closed = expect-op of inner.cursor, ")"
    give { node: inner.node, cursor: closed.cursor }
  fail "line " + (text of t.line) + ": expected a value, found '" + t.text + "'" as parse-error

to continue-postfix of node, cursor:
  t = current of cursor
  is-dot = t.kind == "OP" and t.text == "."
  if is-dot:
    after-dot = advance of cursor
    name-tok = current of after-dot
    new-node = { kind: "Field", obj: node, name: name-tok.text }
    give continue-postfix of new-node, (advance of after-dot)
  else:
    is-bracket = t.kind == "OP" and t.text == "["
    if is-bracket:
      msg = "line " + (text of t.line) + ": '[' has no meaning here -- Planes has no index or slice syntax"
      fail msg as parse-error
    else:
      give { node: node, cursor: cursor }

to parse-postfix of cursor, known:
  primary = parse-primary of cursor, known
  give continue-postfix of primary.node, primary.cursor

to parse-unary of cursor, known:
  is-minus = tok-at-value of cursor, "OP", "-"
  if is-minus:
    inner = parse-unary of (advance of cursor), known
    zero-node = { kind: "Num", value: 0 }
    node = { kind: "BinOp", op: "-", left: zero-node, right: inner.node }
    give { node: node, cursor: inner.cursor }
  else:
    give parse-postfix of cursor, known

to continue-multiplicative of node, cursor, known:
  t = current of cursor
  is-op = t.kind == "OP" and (t.text == "*" or t.text == "/")
  if is-op:
    right = parse-unary of (advance of cursor), known
    new-node = { kind: "BinOp", op: t.text, left: node, right: right.node }
    give continue-multiplicative of new-node, right.cursor, known
  else:
    give { node: node, cursor: cursor }

to parse-multiplicative of cursor, known:
  left = parse-unary of cursor, known
  give continue-multiplicative of left.node, left.cursor, known

to continue-additive of node, cursor, known:
  t = current of cursor
  is-op = t.kind == "OP" and (t.text == "+" or t.text == "-")
  if is-op:
    right = parse-multiplicative of (advance of cursor), known
    new-node = { kind: "BinOp", op: t.text, left: node, right: right.node }
    give continue-additive of new-node, right.cursor, known
  else:
    give { node: node, cursor: cursor }

to parse-additive of cursor, known:
  left = parse-multiplicative of cursor, known
  give continue-additive of left.node, left.cursor, known

to continue-plus of node, cursor, known:
  t = current of cursor
  if t.kind == "PLUS":
    right = parse-additive of (advance of cursor), known
    new-node = { kind: "ListPlus", base: node, item: right.node }
    give continue-plus of new-node, right.cursor, known
  else:
    give { node: node, cursor: cursor }

to parse-plus of cursor, known:
  left = parse-additive of cursor, known
  give continue-plus of left.node, left.cursor, known

to continue-comparison of node, cursor, known:
  t = current of cursor
  is-cmp = t.kind == "OP" and (is-additive-or-comparison-op of t.text) and not (is-additive-op of t.text)
  if is-cmp:
    right = parse-plus of (advance of cursor), known
    new-node = { kind: "BinOp", op: t.text, left: node, right: right.node }
    give continue-comparison of new-node, right.cursor, known
  else:
    if t.kind == "IN":
      right = parse-plus of (advance of cursor), known
      new-node = { kind: "BinOp", op: "in", left: node, right: right.node }
      give continue-comparison of new-node, right.cursor, known
    else:
      is-is-nothing = t.kind == "NAME" and t.text == "is" and (peek-at of cursor, 1).kind == "NOTHING"
      if is-is-nothing:
        after-is = advance of cursor
        after-nothing = advance of after-is
        new-node = { kind: "IsNothing", expr: node }
        give continue-comparison of new-node, after-nothing, known
      else:
        give { node: node, cursor: cursor }

to is-additive-op of txt:
  give txt == "+" or txt == "-"

to parse-comparison of cursor, known:
  left = parse-plus of cursor, known
  give continue-comparison of left.node, left.cursor, known

to parse-not of cursor, known:
  if tok-at of cursor, "NOT":
    inner = parse-not of (advance of cursor), known
    give { node: { kind: "Not", expr: inner.node }, cursor: inner.cursor }
  else:
    give parse-comparison of cursor, known

to continue-and of node, cursor, known:
  if tok-at of cursor, "AND":
    right = parse-not of (advance of cursor), known
    new-node = { kind: "BinOp", op: "and", left: node, right: right.node }
    give continue-and of new-node, right.cursor, known
  else:
    give { node: node, cursor: cursor }

to parse-and of cursor, known:
  left = parse-not of cursor, known
  give continue-and of left.node, left.cursor, known

to continue-or of node, cursor, known:
  # stop at `or fail` -- that OR opens a trailing_or_fail, not a boolean or
  # (parser.py: while self.at("OR") and self.peek(1).kind != "FAIL").
  is-boolean-or = (tok-at of cursor, "OR") and not ((peek-at of cursor, 1).kind == "FAIL")
  if is-boolean-or:
    right = parse-and of (advance of cursor), known
    new-node = { kind: "BinOp", op: "or", left: node, right: right.node }
    give continue-or of new-node, right.cursor, known
  else:
    give { node: node, cursor: cursor }

to parse-or of cursor, known:
  left = parse-and of cursor, known
  give continue-or of left.node, left.cursor, known

# parse-expr = trailing-or-fail(trailing-with(parse-or)) (parser.py). The
# with-clause (RecordUpdate) and `or fail` trailers attach here, above the
# operator chain, so a statement's expression carries both. Field-name
# recognition inside a with-clause is the same keyword-as-field-name
# exception record literals grant (FIELD_NAME_KINDS).

to is-field-name-kind of kind:
  a = kind == "NAME" or kind == "SHOW" or kind == "WRITE" or kind == "FIRST" or kind == "ROUND"
  b = kind == "TO" or kind == "IN" or kind == "WHERE" or kind == "FROM" or kind == "AS"
  c = kind == "OF" or kind == "USE" or kind == "WHY" or kind == "GIVE"
  give a or b or c

to at-field-start of cursor, ahead:
  t = peek-at of cursor, ahead
  nxt = peek-at of cursor, (ahead + 1)
  give (is-field-name-kind of t.kind) and nxt.kind == "OP" and nxt.text == ":"

to parse-with-field of cursor, known:
  after-ws = skip-bracket-ws of cursor
  t = current of after-ws
  if is-field-name-kind of t.kind:
    key = t.text
    colon-expect = expect-op of (advance of after-ws), ":"
    inner = parse-or of colon-expect.cursor, known
    finished = trailing-or-fail of inner.node, inner.cursor, known
    give { key: key, value: finished.node, cursor: finished.cursor }
  else:
    fail "line " + (text of t.line) + ": expected a field name, found '" + t.text + "'" as parse-error

to collect-with-fields of cursor, acc, known:
  comma = try-accept-value of cursor, "OP", ","
  if comma.matched:
    if at-field-start of comma.cursor, 0:
      field = parse-with-field of comma.cursor, known
      give collect-with-fields of field.cursor, (acc plus { key: field.key, value: field.value }), known
    else:
      # the comma belongs to an outer context (arglist, list literal) --
      # leave it unconsumed by returning the pre-comma cursor.
      give { fields: acc, cursor: cursor }
  else:
    give { fields: acc, cursor: cursor }

to trailing-with of node, cursor, known:
  if (tok-at of cursor, "WITH") and (at-field-start of cursor, 1):
    after-with = advance of cursor
    first-field = parse-with-field of after-with, known
    more = collect-with-fields of first-field.cursor, [{ key: first-field.key, value: first-field.value }], known
    new-node = { kind: "RecordUpdate", base: node, fields: more.fields }
    give trailing-with of new-node, more.cursor, known
  else:
    give { node: node, cursor: cursor }

# `or fail as tag [: handler]` -- same line, or an indented continuation.
# Without a handler the tag renames the re-raised failure; with one, the
# handler block runs on failure with `tag` bound to the error record. The
# handler block's iteration upper bound is the cursor itself (the remaining
# token list is always at least as long as the statements it must parse),
# so parse-expr need not thread the whole-file token list down here.
to parse-or-fail-tail of node, cursor, known:
  tag-expect = expect-kind of cursor, "NAME"
  handler-cursor = tag-expect.cursor
  if tok-at-value of handler-cursor, "OP", ":":
    block-start = advance of handler-cursor
    block = parse-block of block-start, block-start, known
    node2 = { kind: "OrFail", expr: node, tag: tag-expect.token.text, handler: block.stmts }
    give { node: node2, cursor: block.cursor }
  else:
    node2 = { kind: "OrFail", expr: node, tag: tag-expect.token.text, handler: nothing }
    give { node: node2, cursor: handler-cursor }

to trailing-or-fail of node, cursor, known:
  is-inline = (tok-at of cursor, "OR") and (peek-at of cursor, 1).kind == "FAIL"
  if is-inline:
    after-or-fail = advance of (advance of cursor)
    as-expect = expect-kind of after-or-fail, "AS"
    give parse-or-fail-tail of node, as-expect.cursor, known
  else:
    is-wrapped = (tok-at of cursor, "EOL") and (peek-at of cursor, 1).kind == "BEGIN" and (peek-at of cursor, 2).kind == "OR" and (peek-at of cursor, 3).kind == "FAIL"
    if is-wrapped:
      after-begin = advance of (advance of cursor)
      after-or-fail = advance of (advance of after-begin)
      as-expect = expect-kind of after-or-fail, "AS"
      tail = parse-or-fail-tail of node, as-expect.cursor, known
      after-blank = skip-blank of tail.cursor
      end-try = try-accept of after-blank, "END"
      give { node: tail.node, cursor: end-try.cursor }
    else:
      give { node: node, cursor: cursor }

to parse-expr of cursor, known:
  or-result = parse-or of cursor, known
  with-result = trailing-with of or-result.node, or-result.cursor, known
  give trailing-or-fail of with-result.node, with-result.cursor, known

# ================================================================ the statement walker (Phase 3)
#
# Iterative, not recursive-descent, for the SEQUENCE of statements at one
# level (capability 4: a for-each pass over the token list costs zero
# Planes-level recursion regardless of length; recursing once per
# statement in a long sequence would scale with file size and hit the
# ~140 ceiling -- #14's own recursion-too-deep fix exists for exactly
# this shape of mistake). `tokens`, the ORIGINAL plain list, drives the
# loop purely as a safe upper bound on iteration count (every statement
# consumes at least one token, so token-count iterations is always
# enough) -- its values are ignored; `program-step` reads the real
# position from `state.cursor`. `known` (the name table) rides in the
# state record alongside `tokens`, threaded into every statement parser.

to program-step of state, ignored-token:
  if state.done:
    give state
  else:
    t = current of state.cursor
    if t.kind == "EOF":
      give { out: state.out, cursor: state.cursor, done: true, tokens: state.tokens, known: state.known }
    else:
      is-skippable = t.kind == "EOL" or t.kind == "END" or (t.kind == "OP" and t.text == ";")
      if is-skippable:
        give { out: state.out, cursor: (advance of state.cursor), done: false, tokens: state.tokens, known: state.known }
      else:
        result = parse-statement of state.cursor, state.tokens, state.known
        new-out = state.out plus result.node
        give { out: new-out, cursor: result.cursor, done: false, tokens: state.tokens, known: state.known }

to run-program of state, tokens:
  result = state
  for each t in tokens:
    result = program-step of result, t
  give result

# parse-block-body/block-step mirror program-step/run-program, but stop
# at the matching END (left unconsumed, for the caller to expect) rather
# than skipping stray ones -- a nested block genuinely owns its closing
# END, where the top level only ever sees leftover ones (already
# consumed by whichever nested parse-block-body closed them). `tokens`
# threaded through every level is the same whole-file list every time --
# a generous but always-sufficient upper bound on how many statements
# ANY block, at any depth, could still need to consume; recursion is
# never used for the sequence itself, only for the depth of NESTING one
# block sits inside another (bounded by how deeply a program indents,
# not by how long it is).

to block-step of state, ignored-token:
  if state.done:
    give state
  else:
    t = current of state.cursor
    is-stop = t.kind == "EOF" or t.kind == "END"
    if is-stop:
      give { out: state.out, cursor: state.cursor, done: true, tokens: state.tokens, known: state.known }
    else:
      is-skippable = t.kind == "EOL" or (t.kind == "OP" and t.text == ";")
      if is-skippable:
        give { out: state.out, cursor: (advance of state.cursor), done: false, tokens: state.tokens, known: state.known }
      else:
        result = parse-statement of state.cursor, state.tokens, state.known
        new-out = state.out plus result.node
        give { out: new-out, cursor: result.cursor, done: false, tokens: state.tokens, known: state.known }

to run-block of state, tokens:
  result = state
  for each t in tokens:
    result = block-step of result, t
  give result

to parse-block-body of cursor, tokens, known:
  initial = { out: [], cursor: cursor, done: false, tokens: tokens, known: known }
  give run-block of initial, tokens

# `<expr> ':' <block>` -- an indented BEGIN...END block, or a single
# inline statement on the same line (parser.py's own parse_block, both
# forms).
to parse-block of cursor, tokens, known:
  if tok-at of cursor, "EOL":
    after-eol = advance of cursor
    begin-expect = expect-kind of after-eol, "BEGIN"
    body = parse-block-body of begin-expect.cursor, tokens, known
    end-try = try-accept of body.cursor, "END"
    give { stmts: body.out, cursor: end-try.cursor }
  else:
    single = parse-statement of cursor, tokens, known
    give { stmts: [single.node], cursor: single.cursor }

to skip-blank of cursor:
  t = current of cursor
  is-eol = t.kind == "EOL"
  is-semi = t.kind == "OP" and t.text == ";"
  if is-eol or is-semi:
    give skip-blank of (advance of cursor)
  else:
    give cursor

# `else` may follow on the same statement's line's own dedent -- EOL
# (and any further blank lines) between the inline `then` and `else`
# must be skipped before checking, exactly like parser.py's save/
# skip_blank/restore. Skipped tokens are NOT kept if there is no
# `else`: the original cursor is returned, leaving them for the
# enclosing block-walker's own EOL handling.
to parse-optional-else of cursor, tokens, known:
  after-blank = skip-blank of cursor
  is-else = tok-at of after-blank, "ELSE"
  if is-else:
    colon-expect = expect-op of (advance of after-blank), ":"
    give parse-block of colon-expect.cursor, tokens, known
  else:
    give { stmts: [], cursor: cursor }

to parse-if of cursor, tokens, known:
  cond-result = parse-expr of (advance of cursor), known
  colon-expect = expect-op of cond-result.cursor, ":"
  then-result = parse-block of colon-expect.cursor, tokens, known
  els-result = parse-optional-else of then-result.cursor, tokens, known
  node = { kind: "If", cond: cond-result.node, then: then-result.stmts, els: els-result.stmts }
  give { node: node, cursor: els-result.cursor }

# `to name...:` -- a multi-word name is every consecutive NAME token
# (parser.py's own read, unrelated to amber's multiword-CALL site, which
# is out of scope here); recursion bounded by how many words a function
# name has, realistically a handful.

to collect-name-parts of cursor, acc:
  if tok-at of cursor, "NAME":
    t = current of cursor
    give collect-name-parts of (advance of cursor), (acc plus t.text)
  else:
    give { parts: acc, cursor: cursor }

to join-with-spaces of parts:
  result = ""
  seen-one = false
  for each p in parts:
    if seen-one:
      result = result + " " + p
    else:
      result = p
      seen-one = true
  give result

to collect-more-params of cursor, acc:
  comma = try-accept-value of cursor, "OP", ","
  if comma.matched:
    param-expect = expect-kind of comma.cursor, "NAME"
    give collect-more-params of param-expect.cursor, (acc plus param-expect.token.text)
  else:
    give { params: acc, cursor: cursor }

to collect-params of cursor:
  first-param = expect-kind of cursor, "NAME"
  give collect-more-params of first-param.cursor, [first-param.token.text]

to parse-funcdef of cursor, tokens, known:
  first-name = expect-kind of (advance of cursor), "NAME"
  remaining = collect-name-parts of first-name.cursor, [first-name.token.text]
  name = join-with-spaces of remaining.parts
  of-try = try-accept of remaining.cursor, "OF"
  if of-try.matched:
    params-result = collect-params of of-try.cursor
    give finish-funcdef of name, params-result.params, params-result.cursor, tokens, known
  else:
    give finish-funcdef of name, [], remaining.cursor, tokens, known

to finish-funcdef of name, params, cursor, tokens, known:
  colon-expect = expect-op of cursor, ":"
  body = parse-block of colon-expect.cursor, tokens, known
  node = { kind: "FuncDef", name: name, params: params, body: body.stmts }
  give { node: node, cursor: body.cursor }

# parser.py's parse_statement dispatch order, exactly: use, foreign, rule,
# note, funcdef, give, show, why, write, if, when, for, let, assign, fail,
# and finally a bare expression (the fallthrough parser.planes lacked
# before Phase 4 -- `return self.parse_expr()`, which makes a call or any
# other expression a valid statement). `rule` and the assignments carry a
# trailing `because`; the assignments handle theirs inside parse-because.
to parse-statement of cursor, tokens, known:
  t = current of cursor
  next = peek-at of cursor, 1
  is-assign = t.kind == "NAME" and next.kind == "OP" and next.text == "="
  is-funcdef = t.kind == "TO" and next.kind == "NAME"
  is-note = t.kind == "NAME" and t.text == "note" and next.kind == "OP" and next.text == ":"
  if t.kind == "USE":
    give parse-use of cursor, known
  if t.kind == "FOREIGN":
    give parse-foreign of cursor
  if t.kind == "RULE":
    rule-result = parse-rule of cursor
    give parse-because of rule-result.node, rule-result.cursor
  if is-note:
    give parse-note of cursor
  if is-funcdef:
    give parse-funcdef of cursor, tokens, known
  if t.kind == "GIVE":
    give parse-give of cursor, known
  if t.kind == "SHOW":
    give parse-show of t.line, cursor, known
  if t.kind == "WHY":
    give parse-why of cursor, known
  if t.kind == "WRITE":
    give parse-write of cursor, known
  if t.kind == "IF":
    give parse-if of cursor, tokens, known
  if t.kind == "WHEN":
    give parse-when of cursor, tokens, known
  if t.kind == "FOR":
    give parse-foreach of cursor, tokens, known
  if t.kind == "LET":
    give parse-let of cursor, known
  if is-assign:
    give parse-assign of t.text, cursor, known
  if t.kind == "FAIL":
    give parse-fail of cursor, known
  give parse-expr of cursor, known

to parse-give of cursor, known:
  result = parse-expr of (advance of cursor), known
  give { node: { kind: "Give", expr: result.node }, cursor: result.cursor }

# `for each name in source [where cond]: body` -- the statement form only
# (as_expr=False in parser.py; the wrapped comprehension-header shape
# used only from expression context is out of this build's scope, same
# as list/record literals in Phase 2).

to parse-optional-where of cursor, known:
  if tok-at of cursor, "WHERE":
    result = parse-or of (advance of cursor), known
    give { node: result.node, cursor: result.cursor }
  else:
    give { node: nothing, cursor: cursor }

to parse-foreach of cursor, tokens, known:
  each-expect = expect-kind of (advance of cursor), "EACH"
  var-expect = expect-kind of each-expect.cursor, "NAME"
  in-expect = expect-kind of var-expect.cursor, "IN"
  source-result = parse-or of in-expect.cursor, known
  where-result = parse-optional-where of source-result.cursor, known
  colon-expect = expect-op of where-result.cursor, ":"
  body = parse-block of colon-expect.cursor, tokens, known
  node = { kind: "ForEach", var: var-expect.token.text, source: source-result.node, where: where-result.node, body: body.stmts, is-expr: false }
  give { node: node, cursor: body.cursor }

# `use module [with old as new [with old as new ...]]`. Site 4
# (check_rename_name_ambiguity) checks the `old` half of each rename: it is
# a lookup against the module's exported names (via the name table), so a
# shorter exported prefix is a real second reading. `new` is not a lookup
# (the alias is introduced right here) and is not checked. read-multiword-
# name keeps the split words so the check needs no string split. The `with`
# token's line is threaded so the refusal cites the same line parser.py's
# `with_tok.line` does.

to read-multiword-name of cursor:
  result = collect-name-parts of cursor, []
  give { text: (join-with-spaces of result.parts), parts: result.parts, cursor: result.cursor }

to collect-renames of cursor, acc, known, with-line:
  old-result = read-multiword-name of cursor
  guard = check-rename-name-ambiguity of known, old-result.parts, old-result.text, with-line
  as-expect = expect-kind of old-result.cursor, "AS"
  new-result = read-multiword-name of as-expect.cursor
  pair = { old: old-result.text, new: new-result.text }
  new-acc = acc plus pair
  with-try = try-accept of new-result.cursor, "WITH"
  if with-try.matched:
    give collect-renames of with-try.cursor, new-acc, known, with-try.token.line
  else:
    give { renames: new-acc, cursor: new-result.cursor }

to parse-use of cursor, known:
  module-expect = expect-kind of (advance of cursor), "NAME"
  with-try = try-accept of module-expect.cursor, "WITH"
  if with-try.matched:
    renames-result = collect-renames of with-try.cursor, [], known, with-try.token.line
    node = { kind: "Use", module: module-expect.token.text, renames: renames-result.renames }
    give { node: node, cursor: renames-result.cursor }
  else:
    node = { kind: "Use", module: module-expect.token.text, renames: [] }
    give { node: node, cursor: module-expect.cursor }

to parse-assign of name, cursor, known:
  after-eq = advance of (advance of cursor)
  result = parse-expr of after-eq, known
  node = { kind: "Assign", name: name, expr: result.node, is-let: false, annotation: nothing }
  give parse-because of node, result.cursor

to parse-let of cursor, known:
  name-expect = expect-kind of (advance of cursor), "NAME"
  eq-expect = expect-op of name-expect.cursor, "="
  result = parse-expr of eq-expect.cursor, known
  node = { kind: "Assign", name: name-expect.token.text, expr: result.node, is-let: true, annotation: nothing }
  give parse-because of node, result.cursor

to parse-show of line, cursor, known:
  result = parse-expr of (advance of cursor), known
  node = { kind: "Show", expr: result.node, line: line }
  give { node: node, cursor: result.cursor }

# ================================================================ the remaining statement forms (Phase 4)
#
# write, why, fail, foreign, rule, note, when -- every one built from
# already-reserved keywords (section 7 invariant 1: no new keyword,
# builtin, effect kind, or host method). Faithful ports of parser.py's
# parse_foreign / parse_rule / parse_note / parse_when and the WriteTo /
# Why / Fail statement forms.

to parse-write of cursor, known:
  write-tok = current of cursor
  value-result = parse-or of (advance of cursor), known
  to-expect = expect-kind of value-result.cursor, "TO"
  dest-result = parse-or of to-expect.cursor, known
  node = { kind: "WriteTo", value: value-result.node, dest: dest-result.node, line: write-tok.line }
  give trailing-or-fail of node, dest-result.cursor, known

to parse-why of cursor, known:
  result = parse-expr of (advance of cursor), known
  give { node: { kind: "Why", expr: result.node }, cursor: result.cursor }

to parse-fail of cursor, known:
  fail-tok = current of cursor
  msg-result = parse-expr of (advance of cursor), known
  as-expect = expect-kind of msg-result.cursor, "AS"
  tag-expect = expect-kind of as-expect.cursor, "NAME"
  node = { kind: "Fail", message: msg-result.node, tag: tag-expect.token.text, line: fail-tok.line }
  give { node: node, cursor: tag-expect.cursor }

# ---- foreign: `foreign name [of params] from "target" [doing claims]`.
# An effect claim is a kind and, optionally, where it goes: a fixed literal,
# a named parameter, or nothing. A `doing nothing` claim carries no effect
# and is dropped, exactly as parser.py filters c[0] != "nothing".

to is-effect-kind of kind:
  a = kind == "ask" or kind == "read" or kind == "write" or kind == "show"
  b = kind == "clock" or kind == "random" or kind == "env"
  give a or b

# The seven kinds, written out, for the message. It has to stay in step with
# `is-effect-kind` directly above -- the vocabulary is closed, and both places
# that name it are the same list in a different shape.
to effect-kinds-text:
  give "ask, clock, env, random, read, show, write"

# S160: the membership check lives HERE, so an unknown effect name is refused
# in every position that reads one. It used to live in parse-rule, after the
# call, and read-claim made no such check -- so
# `foreign f of x from "m.f" doing frobnicate` parsed and silently widened a
# vocabulary closed at seven, while the same word in a rule was refused.
#
# `allow-nothing` is an explicit argument rather than an inference from
# `after`: `nothing` is valid after `doing` (a foreign that performs none) and
# not in a rule, and reading that off the message text would tie the grammar to
# the wording of a message.
#
# C4 also gives this message its continuation clause. It had none, so the
# self-hosted parser refused in fewer words than parser.py and js/parser.mjs
# did for the same input -- a fix-clause divergence nothing asserted, because
# the self-hosted parser suites compare ASTs and error tags rather than text.
to read-effect-word of cursor, after, allow-nothing:
  t = current of cursor
  ok = t.kind == "NAME" or t.kind == "NOTHING" or t.kind == "SHOW" or t.kind == "WRITE"
  word = t.text
  if word == "":
    word = "nothing"
  known = false
  if ok:
    if is-effect-kind of word:
      known = true
    if allow-nothing:
      if word == "nothing":
        known = true
  if known:
    give { word: word, cursor: (advance of cursor) }
  else:
    found = t.text
    if ok:
      found = word
    if found == "":
      found = "end of line"
    fail "line " + (text of t.line) + ": expected an effect name after " + after + ", found '" + found + "'\n  valid kinds: " + (effect-kinds-text) + " — and 'nothing' after 'doing', for a foreign that performs none" as parse-error

to param-includes of params, name:
  result = false
  for each p in params:
    if p == name:
      result = true
  give result

to read-claim of cursor, params:
  ew = read-effect-word of cursor, "'doing'", true
  kind = ew.word
  after = ew.cursor
  if kind == "nothing":
    give { claim: { kind: "nothing", target-tag: "none", target-value: nothing }, cursor: after }
  else:
    t = current of after
    if t.kind == "STRING":
      give { claim: { kind: kind, target-tag: "literal", target-value: (strip-quotes of t.text) }, cursor: (advance of after) }
    else:
      if t.kind == "NAME" and (param-includes of params, t.text):
        give { claim: { kind: kind, target-tag: "param", target-value: t.text }, cursor: (advance of after) }
      else:
        if t.kind == "NAME":
          fail "line " + (text of t.line) + ": '" + t.text + "' is not a parameter of this function, so it cannot be where '" + kind + "' goes" as parse-error
        else:
          give { claim: { kind: kind, target-tag: "none", target-value: nothing }, cursor: after }

to filter-nonnothing of claims:
  result = []
  for each c in claims:
    if not (c.kind == "nothing"):
      result = result plus c
  give result

to collect-claims of cursor, acc, params:
  comma = try-accept-value of cursor, "OP", ","
  if comma.matched:
    next = read-claim of comma.cursor, params
    give collect-claims of next.cursor, (acc plus next.claim), params
  else:
    give { effects: (filter-nonnothing of acc), cursor: cursor }

to parse-foreign-params of cursor:
  of-try = try-accept of cursor, "OF"
  if of-try.matched:
    params = collect-params of of-try.cursor
    give { params: params.params, cursor: params.cursor }
  else:
    give { params: [], cursor: cursor }

to parse-foreign of cursor:
  foreign-tok = current of cursor
  first-name = expect-kind of (advance of cursor), "NAME"
  name-result = collect-name-parts of first-name.cursor, [first-name.token.text]
  name = join-with-spaces of name-result.parts
  params-result = parse-foreign-params of name-result.cursor
  from-expect = expect-kind of params-result.cursor, "FROM"
  target-expect = expect-kind of from-expect.cursor, "STRING"
  target = strip-quotes of target-expect.token.text
  doing-try = try-accept of target-expect.cursor, "DOING"
  if doing-try.matched:
    first-claim = read-claim of doing-try.cursor, params-result.params
    claims-result = collect-claims of first-claim.cursor, [first-claim.claim], params-result.params
    node = { kind: "Foreign", name: name, params: params-result.params, target: target, effects: claims-result.effects, declared: true, line: foreign-tok.line }
    give { node: node, cursor: claims-result.cursor }
  else:
    node = { kind: "Foreign", name: name, params: params-result.params, target: target, effects: [], declared: false, line: foreign-tok.line }
    give { node: node, cursor: target-expect.cursor }

# ---- rule: `rule [name] subject may[ not] kind [to "target"]
# [supersedes [other] [@fp]] [because "..."]`. Never executes; the checker
# reads it. `may`, `supersedes` and `because` are read positionally, so
# none is reserved (positional_words in grammar/vocabulary.json).

to drop-first-char of s:
  result = ""
  at-start = true
  for each c in s:
    if at-start:
      at-start = false
    else:
      result = result + c
  give result

to parse-rule-target of cursor:
  to-try = try-accept of cursor, "TO"
  if to-try.matched:
    target-expect = expect-kind of to-try.cursor, "STRING"
    give { target: (strip-quotes of target-expect.token.text), cursor: target-expect.cursor }
  else:
    give { target: nothing, cursor: cursor }

to parse-rule-supersedes of cursor:
  is-sup = (tok-at of cursor, "NAME") and (current of cursor).text == "supersedes"
  if is-sup:
    after-sup = advance of cursor
    open-expect = expect-op of after-sup, "["
    name-expect = expect-kind of open-expect.cursor, "NAME"
    close-expect = expect-op of name-expect.cursor, "]"
    fp-try = try-accept of close-expect.cursor, "FINGERPRINT"
    if fp-try.matched:
      give { supersedes: name-expect.token.text, fingerprint: (drop-first-char of fp-try.token.text), cursor: fp-try.cursor }
    else:
      give { supersedes: name-expect.token.text, fingerprint: nothing, cursor: close-expect.cursor }
  else:
    give { supersedes: nothing, fingerprint: nothing, cursor: cursor }

to parse-rule of cursor:
  rule-tok = current of cursor
  open-expect = expect-op of (advance of cursor), "["
  name-expect = expect-kind of open-expect.cursor, "NAME"
  close-expect = expect-op of name-expect.cursor, "]"
  subject-expect = expect-kind of close-expect.cursor, "NAME"
  may-tok = current of subject-expect.cursor
  is-may = may-tok.kind == "NAME" and may-tok.text == "may"
  if not is-may:
    fail "line " + (text of may-tok.line) + ": expected 'may not' or 'may' after a rule's subject, found '" + may-tok.text + "'" as parse-error
  else:
    after-may = advance of subject-expect.cursor
    not-try = try-accept of after-may, "NOT"
    if not-try.matched:
      assertion = "forbid"
      after-assertion = not-try.cursor
      verb = "may not"
    else:
      assertion = "permit"
      after-assertion = after-may
      verb = "may"
    # S160: one membership check, in read-effect-word, for both positions.
    # `nothing` is a foreign's way of claiming no effect; it means nothing in
    # a rule, so this caller does not allow it.
    kind-result = read-effect-word of after-assertion, ("'" + verb + "'"), false
    target-result = parse-rule-target of kind-result.cursor
    sup-result = parse-rule-supersedes of target-result.cursor
    node = { kind: "Rule", name: name-expect.token.text, subject: subject-expect.token.text, rule-kind: kind-result.word, target: target-result.target, line: rule-tok.line, supersedes: sup-result.supersedes, assertion: assertion, supersedes-fingerprint: sup-result.fingerprint, annotation: nothing }
    give { node: node, cursor: sup-result.cursor }

# ---- note: `note:` then an indented block of `from "..."` and
# `derives-from [rule]` entries, or a single inline entry. Never executes.

to parse-note-entry of cursor:
  if tok-at of cursor, "FROM":
    after-from = advance of cursor
    src-expect = expect-kind of after-from, "STRING"
    give { entry: { kind: "from", value: (strip-quotes of src-expect.token.text) }, cursor: src-expect.cursor }
  else:
    is-derives = (tok-at of cursor, "NAME") and (current of cursor).text == "derives-from"
    if is-derives:
      after-d = advance of cursor
      open-expect = expect-op of after-d, "["
      name-expect = expect-kind of open-expect.cursor, "NAME"
      close-expect = expect-op of name-expect.cursor, "]"
      give { entry: { kind: "derives-from", value: name-expect.token.text }, cursor: close-expect.cursor }
    else:
      t = current of cursor
      fail "line " + (text of t.line) + ": unrecognised entry in a note, found '" + t.text + "'" as parse-error

to collect-note-entries of state, ignored-token:
  if state.done:
    give state
  else:
    t = current of state.cursor
    is-stop = t.kind == "EOF" or t.kind == "END"
    if is-stop:
      give { out: state.out, cursor: state.cursor, done: true, tokens: state.tokens }
    else:
      is-skippable = t.kind == "EOL" or (t.kind == "OP" and t.text == ";")
      if is-skippable:
        give { out: state.out, cursor: (advance of state.cursor), done: false, tokens: state.tokens }
      else:
        entry-result = parse-note-entry of state.cursor
        give { out: (state.out plus entry-result.entry), cursor: entry-result.cursor, done: false, tokens: state.tokens }

to run-note-entries of state, tokens:
  result = state
  for each tok in tokens:
    result = collect-note-entries of result, tok
  give result

to parse-note of cursor:
  note-tok = current of cursor
  colon-expect = expect-op of (advance of cursor), ":"
  if tok-at of colon-expect.cursor, "EOL":
    begin-expect = expect-kind of (advance of colon-expect.cursor), "BEGIN"
    initial = { out: [], cursor: begin-expect.cursor, done: false, tokens: begin-expect.cursor }
    final = run-note-entries of initial, begin-expect.cursor
    end-try = try-accept of final.cursor, "END"
    node = { kind: "Note", entries: final.out, line: note-tok.line }
    give { node: node, cursor: end-try.cursor }
  else:
    entry-result = parse-note-entry of colon-expect.cursor
    node = { kind: "Note", entries: [entry-result.entry], line: note-tok.line }
    give { node: node, cursor: entry-result.cursor }

# ---- when: `when subject is { field: expr, bindname, ... }: body
# [else: els]`. A pattern entry is a match constraint (field: expr) or a
# bare binding (field). `is` is read positionally (positional_words).

to parse-when-pattern-entry of cursor, known:
  after-ws = skip-bracket-ws of cursor
  t = current of after-ws
  if is-field-name-kind of t.kind:
    name = t.text
    after-name = advance of after-ws
    if tok-at-value of after-name, "OP", ":":
      value-result = parse-expr of (advance of after-name), known
      entry = { field: name, matcher-tag: "match", value: value-result.node }
      give { entry: entry, cursor: value-result.cursor }
    else:
      entry = { field: name, matcher-tag: "bind", value: name }
      give { entry: entry, cursor: after-name }
  else:
    fail "line " + (text of t.line) + ": expected a field name, found '" + t.text + "'" as parse-error

to collect-when-pattern of cursor, acc, known:
  comma = try-accept-value of cursor, "OP", ","
  if comma.matched:
    after-ws = skip-bracket-ws of comma.cursor
    if tok-at-value of after-ws, "OP", "}":
      give { pattern: acc, cursor: after-ws }
    else:
      next = parse-when-pattern-entry of after-ws, known
      give collect-when-pattern of next.cursor, (acc plus next.entry), known
  else:
    give { pattern: acc, cursor: cursor }

to parse-when-pattern of cursor, known:
  after-ws = skip-bracket-ws of cursor
  if tok-at-value of after-ws, "OP", "}":
    give { pattern: [], cursor: after-ws }
  else:
    first-entry = parse-when-pattern-entry of after-ws, known
    give collect-when-pattern of first-entry.cursor, [first-entry.entry], known

to parse-when of cursor, tokens, known:
  subject-result = parse-expr of (advance of cursor), known
  is-tok = current of subject-result.cursor
  is-is = is-tok.kind == "NAME" and is-tok.text == "is"
  if not is-is:
    fail "line " + (text of is-tok.line) + ": expected is, found '" + is-tok.text + "'" as parse-error
  else:
    brace-expect = expect-op of (advance of subject-result.cursor), "{"
    pattern-result = parse-when-pattern of brace-expect.cursor, known
    close-expect = expect-op of pattern-result.cursor, "}"
    colon-expect = expect-op of close-expect.cursor, ":"
    body = parse-block of colon-expect.cursor, tokens, known
    els-result = parse-optional-else of body.cursor, tokens, known
    node = { kind: "When", subject: subject-result.node, pattern: pattern-result.pattern, body: body.stmts, els: els-result.stmts }
    give { node: node, cursor: els-result.cursor }

# ---- for each ... as an EXPRESSION (a comprehension). parse_foreach's
# as_expr path: the body is a single expression, inline or on an indented
# next line, and the header's where-clause may wrap across a line.

to parse-foreach-expr of cursor, known:
  each-expect = expect-kind of (advance of cursor), "EACH"
  var-expect = expect-kind of each-expect.cursor, "NAME"
  in-expect = expect-kind of var-expect.cursor, "IN"
  source-result = parse-or of in-expect.cursor, known
  hdr-eol = tok-at of source-result.cursor, "EOL"
  hdr-begin = (peek-at of source-result.cursor, 1).kind == "BEGIN"
  hdr-next = (peek-at of source-result.cursor, 2).kind == "WHERE" or (peek-at of source-result.cursor, 2).kind == "OP"
  header-wrapped = hdr-eol and hdr-begin and hdr-next
  if header-wrapped:
    hdr-cursor = advance of (advance of source-result.cursor)
    where-result = parse-optional-where of hdr-cursor, known
    colon-expect = expect-op of where-result.cursor, ":"
    body-result = parse-expr of colon-expect.cursor, known
    after-blank = skip-blank of body-result.cursor
    end-try = try-accept of after-blank, "END"
    node = { kind: "ForEach", var: var-expect.token.text, source: source-result.node, where: where-result.node, body: [body-result.node], is-expr: true }
    give { node: node, cursor: end-try.cursor }
  else:
    where-result = parse-optional-where of source-result.cursor, known
    colon-expect = expect-op of where-result.cursor, ":"
    if tok-at of colon-expect.cursor, "EOL":
      begin-expect = expect-kind of (advance of colon-expect.cursor), "BEGIN"
      body-result = parse-expr of begin-expect.cursor, known
      after-blank = skip-blank of body-result.cursor
      end-try = try-accept of after-blank, "END"
      node = { kind: "ForEach", var: var-expect.token.text, source: source-result.node, where: where-result.node, body: [body-result.node], is-expr: true }
      give { node: node, cursor: end-try.cursor }
    else:
      body-result = parse-expr of colon-expect.cursor, known
      node = { kind: "ForEach", var: var-expect.token.text, source: source-result.node, where: where-result.node, body: [body-result.node], is-expr: true }
      give { node: node, cursor: body-result.cursor }

# ---- because: a trailing rationale on an Assign or Rule, same line or an
# indented continuation. Attaches a Because { text, line } via `with`.

to finish-because of attach, cursor:
  t = current of cursor
  if not (t.kind == "STRING"):
    fail "line " + (text of t.line) + ": 'because' needs a quoted reason" as parse-error
  else:
    reason = strip-quotes of t.text
    because-node = { text: reason, line: t.line }
    give { node: (attach with annotation: because-node), cursor: (advance of cursor) }

to parse-because of attach, cursor:
  is-inline = (tok-at of cursor, "NAME") and (current of cursor).text == "because"
  if is-inline:
    give finish-because of attach, (advance of cursor)
  else:
    is-wrapped = (tok-at of cursor, "EOL") and (peek-at of cursor, 1).kind == "BEGIN" and (peek-at of cursor, 2).kind == "NAME" and (peek-at of cursor, 2).text == "because"
    if is-wrapped:
      after-because = advance of (advance of (advance of cursor))
      result = finish-because of attach, after-because
      after-blank = skip-blank of result.cursor
      end-try = try-accept of after-blank, "END"
      give { node: result.node, cursor: end-try.cursor }
    else:
      give { node: attach, cursor: cursor }

# ================================================================ entry points

to canonical-of-expr-source of src:
  toks = tokenize of src
  known = build-known of toks
  result = parse-or of toks, known
  give canonical-of-node of result.node, ""

to canonical-of-program of nodes:
  lines = []
  for each node in nodes:
    lines = lines plus (canonical-of-node of node, "")
  give join-with-newlines of lines

to canonical-of-program-source of src:
  toks = tokenize of src
  known = build-known of toks
  initial = { out: [], cursor: toks, done: false, tokens: toks, known: known }
  final = run-program of initial, toks
  give canonical-of-program of final.out

# Cross-file known names (parser.py's `parse(src, known)`): function names
# a file calls but defines elsewhere, resolved from its `use`d modules. They
# sit between builtins and this file's own prescan, so a local definition
# still wins (merged.update order in parse()). `extra-known` is a list of
# { name, arity } records. Used by the corpus harness for the one file
# (demo/app/net.planes) that calls a sibling's multi-word function and so
# cannot be parsed standalone -- both parser.py and this parser need the
# same table to read `api base` as one call rather than a syntax error.
to build-known-with of tokens, extra-known:
  prescanned = prescan-funcs of tokens
  with-extra = append-all of (builtin-entries), extra-known
  give append-all of with-extra, prescanned

to canonical-of-program-source-with-known of src, extra-known:
  toks = tokenize of src
  known = build-known-with of toks, extra-known
  initial = { out: [], cursor: toks, done: false, tokens: toks, known: known }
  final = run-program of initial, toks
  give canonical-of-program of final.out
