# A generative bloom of pulsating rings, driven by the tick counter alone —
# no input, no state threaded across ticks (A.6). Motion needs no event: the
# whole picture is a pure function of `tick`, recomputed fresh on every call.
#
# `mod` comes from math.planes now (checkpoint v21.0 §250 — harvested from
# this file and snake.planes, two witnesses of three, floored rather than
# either witness's original truncated definition). The local ramp-up-ramp-
# down wave `mod`'s sudden snap-back-to-zero gets folded into stayed local —
# one witness only, and the harvest rule does not admit on one — but it is
# named `pulse` here rather than its old name `triangle`: that name now
# belongs to draw.planes's shape verb, and a module graph cannot hold two
# functions of the same name (checkpoint v21.0 §250's own worked example is a
# `mod` collision; this is the same rule catching a different one).
#
# Colour is OKLCH throughout (planes-drawing-protocol-v1.md §4): the whole
# palette's hue rotates with `tick`, and each ring is offset from the last by
# a fixed 18 degrees — an analogous harmony spreading outward through the
# rings, computed by addition on hue rather than hand-mixed per-channel
# arithmetic, and wrapped with the same floored `mod` hue arithmetic needs.

use draw
use math

to pulse of t, half-period:
  let folded = mod of t, (half-period * 2)
  if folded < half-period:
    give folded
  else:
    give (half-period * 2) - folded

to rings of ring-index, ring-count, tick, center-x, center-y, base-hue:
  if ring-index >= ring-count:
    give nothing
  else:
    let period = 48
    let offset = ring-index * 12
    let phase = pulse of (tick + offset), period because "each ring is offset from the last by twelve ticks, so the pulse travels outward through the rings instead of all of them beating in lockstep"
    let radius = 16 + phase * 1.6
    let lightness = 0.45 + (phase / period) * 0.35 because "the pulse modulates lightness now, in place of the old hand-mixed red/green channels"
    let hue = mod of (base-hue + ring-index * 18), 360 because "an analogous harmony: each ring eighteen degrees further round the wheel than the last, wrapped by the shared floored mod"

    stroke of lightness, 0.15, hue, 1
    circle of center-x, center-y, radius

    rings of (ring-index + 1), ring-count, tick, center-x, center-y, base-hue

clear
width of 2

let drift-x = pulse of tick, 110 because "a smooth ramp from 0 to 110 and back, so the bloom's centre drifts sideways instead of sitting still"
let drift-y = pulse of (tick + 30), 70 because "offsetting the vertical drift's phase from the horizontal one is what keeps the centre off a single straight line"
let center-x = 90 + drift-x
let center-y = 100 + drift-y

let base-hue = mod of (tick * 2), 360 because "the whole palette rotates through hue over time, wrapping at 360 the same way the per-ring offset does"

let ring-count = 10
rings of 0, ring-count, tick, center-x, center-y, base-hue
