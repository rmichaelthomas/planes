# paint/scene.planes — the vocabulary a child is given in week 1 (checkpoint
# v26.0 §383-407). This is a TEACHING vocabulary: one wrapper per idea and
# nothing else, the same discipline paint/draw.planes follows over the
# protocol itself. Every drawing command below goes through a draw.planes
# helper — this file defines no protocol surface of its own. Its OKLCH
# numbers (`fill`/`stroke`/`background`'s l, c, h, a) are the only colour
# literals a child's own program ever has to look at; her program only ever
# writes phrases like "wet grass" and coordinates like `120, 90`.

use draw

# `horizon` is a zero-argument FUNCTION, not a top-level `let` — a `let` at a
# used module's top level is hoisted as a declaration but its right-hand side
# never runs (interp.py's `hoist` only registers function definitions; a
# module's own top-level statements execute only when IT is the entry file,
# and scene.planes is always `use`d, never the entry). A function is hoisted
# and callable regardless, so the y-coordinate where the sky ends and the
# ground begins — shared by `ground`'s own band and by every flower's stem —
# is written once here rather than twice.
to horizon:
  give 264

to start:
  show "draw protocol 3"
  clear

to sky of feeling:
  if feeling == "early morning":
    background of 0.82, 0.05, 40
  else:
    if feeling == "middle of the afternoon":
      background of 0.75, 0.12, 230
    else:
      if feeling == "just before dark":
        background of 0.45, 0.14, 300
      else:
        if feeling == "the middle of the night":
          background of 0.15, 0.05, 260
        else:
          fail "\"" + feeling + "\" isn't a sky this program knows — try one of: early morning, middle of the afternoon, just before dark, the middle of the night" as unknown-sky-feeling

to ground of feeling:
  if feeling == "wet grass":
    fill of 0.40, 0.13, 145, 1
  else:
    if feeling == "dry grass":
      fill of 0.62, 0.09, 95, 1
    else:
      if feeling == "dirt":
        fill of 0.40, 0.08, 55, 1
      else:
        fail "\"" + feeling + "\" isn't a ground this program knows — try one of: wet grass, dry grass, dirt" as unknown-ground-feeling
  rect of 0, horizon, 480, 96, 0

to sun of x, y:
  fill of 0.95, 0.10, 85, 1
  circle of x, y, 26

to moon of x, y:
  fill of 0.93, 0.02, 250, 1
  circle of x, y, 20

to star of x, y:
  fill of 0.97, 0.04, 250, 1
  circle of x, y, 3

to flower of x, tall:
  stroke of 0.45, 0.12, 145, 1
  width of 2
  line of x, horizon, x, (horizon - tall)
  fill of 0.75, 0.15, 25, 1
  circle of x, (horizon - tall), 9

to bee of x, y:
  fill of 0.75, 0.15, 85, 1
  circle of x, y, 5
  stroke of 0.35, 0.08, 70, 1
  width of 1.5
  line of (x - 3), (y - 1), (x + 3), (y - 1)
  line of (x - 3), (y + 1), (x + 3), (y + 1)

to firefly of x, y:
  fill of 0.85, 0.18, 95, 1
  circle of x, y, 2
