# A playable snake: arrow keys steer, the tail follows, an apple grows it, a
# wall or its own tail ends it. State crosses the tick boundary through the
# VFS, one direction (A.3): `write state to "state.json"` out, and the
# harness reads it back as the next tick's `state` literal — no `read`, no
# JSON parsing inside this program.
#
# The board is a 24-by-18 grid of 20-pixel cells. `body` holds every segment
# behind the head, oldest first, NOT including the head itself: moving
# without growing drops the oldest segment (`rest of body`) and appends the
# just-vacated head position (`plus`); eating the apple appends without
# dropping, which is the whole of how the snake grows.
#
# `random` is one of the seven effect kinds, but reaching it needs a
# `foreign … doing random` declaration — and this build makes none (A.1,
# A.3): a claimed effect surface wider than console-and-file is exactly what
# this example exists to NOT show. So the apple's next cell is a
# deterministic function of the score instead of true randomness, using
# `mod` from math.planes now (checkpoint v21.0 §250 — harvested from this
# file and bloom.planes, two witnesses of three; this file's own copy is
# gone).

use draw
use math
use file

let grid-columns = 24
let grid-rows = 18
let cell-size = 20
let board-width = grid-columns * cell-size because "the board's own size in pixels, so the drawing below centres text on the board's midpoint rather than on a hand-tuned number that happens to look centred"
let board-height = grid-rows * cell-size

to advance of old, keys:
  if not old.alive:
    next = old
  else:
    dir-x = old.dir-x
    dir-y = old.dir-y
    if ("ArrowLeft" in keys) and not (old.dir-x == 1):
      dir-x = -1
      dir-y = 0
    if ("ArrowRight" in keys) and not (old.dir-x == -1):
      dir-x = 1
      dir-y = 0
    if ("ArrowUp" in keys) and not (old.dir-y == 1):
      dir-x = 0
      dir-y = -1
    if ("ArrowDown" in keys) and not (old.dir-y == -1):
      dir-x = 0
      dir-y = 1

    new-head-x = old.head-x + dir-x
    new-head-y = old.head-y + dir-y

    hit-wall = new-head-x < 0 or new-head-x >= grid-columns or new-head-y < 0 or new-head-y >= grid-rows
    self-hits = for each seg in old.body where seg.x == new-head-x and seg.y == new-head-y: seg
    hit-self = count of self-hits > 0

    if hit-wall or hit-self:
      next = old with alive: false because "freeze the board on the losing tick, so the position that ended the game stays on screen instead of vanishing"
    else:
      old-head = { x: old.head-x, y: old.head-y }
      score = old.score
      body = (rest of old.body) plus old-head
      apple-x = old.apple-x
      apple-y = old.apple-y

      ate-apple = new-head-x == old.apple-x and new-head-y == old.apple-y
      if ate-apple:
        score = old.score + 1
        body = old.body plus old-head
        apple-x = mod of (7 + score * 13), grid-columns
        apple-y = mod of (3 + score * 17), grid-rows

      next = {
        head-x: new-head-x, head-y: new-head-y,
        dir-x: dir-x, dir-y: dir-y,
        body: body,
        apple-x: apple-x, apple-y: apple-y,
        score: score,
        alive: true
      }
  give next

if state is nothing:
  next = {
    head-x: 12, head-y: 9,
    dir-x: 1, dir-y: 0,
    body: [{ x: 10, y: 9 }, { x: 11, y: 9 }],
    apple-x: 18, apple-y: 4,
    score: 0,
    alive: true
  }
else:
  next = advance of state, keys

write next to "state.json"

# ---- drawing ---------------------------------------------------------------
#
# Everything below the state write is picture, and nothing below it can change
# the game. The two helpers here are drawing helpers and live with the
# drawing.

to grid-verticals of i:
  if i >= grid-columns:
    give nothing
  else:
    let x = i * cell-size
    line of x, 0, x, board-height
    grid-verticals of (i + 1)

to grid-horizontals of j:
  if j >= grid-rows:
    give nothing
  else:
    let y = j * cell-size
    line of 0, y, board-width, y
    grid-horizontals of (j + 1)

clear

# The grid goes down first, under everything else. Any grey solid enough to
# see used to compete with the play field; at a tenth of an alpha it reads as
# ruling on paper and the eye stops noticing it after a second.
let grid-alpha = 0.12 because "the lowest alpha that still resolves as a line on both a light and a dark page — the grid has to be legible enough to count cells with and faint enough to disappear behind the game"
stroke of 0.5, 0, 0, grid-alpha
width of 1
grid-verticals of 1
grid-horizontals of 1

# dot/box never had an outline; fill+circle/rect now stroke by default, so an
# explicit transparent stroke keeps the borderless look.
stroke of 0, 0, 0, 0

fill of 0.55, 0.19, 25, 1
apple-cx = next.apple-x * cell-size + (cell-size / 2)
apple-cy = next.apple-y * cell-size + (cell-size / 2)
circle of apple-cx, apple-cy, (cell-size * 0.4)

# `body` is oldest-segment-first, so the running index counts from the tail
# tip toward the head — and lightness rising along it is what makes which way
# the snake is travelling readable in a still frame.
segment-count = count of next.body
ramp-index = 0
for each seg in next.body:
  nearness = (ramp-index + 1) / segment-count
  fill of (0.36 + nearness * 0.26), 0.14, 145, 1
  seg-px = seg.x * cell-size + 1
  seg-py = seg.y * cell-size + 1
  rect of seg-px, seg-py, (cell-size - 2), (cell-size - 2)
  ramp-index = ramp-index + 1

# The head is a triangle rather than a square, pointed the way the snake is
# going. `dir-x`/`dir-y` is a unit vector and its perpendicular is the same
# two numbers swapped with one negated, so the three corners are arithmetic —
# no rotation and no angle.
fill of 0.82, 0.17, 128, 1
head-cx = next.head-x * cell-size + (cell-size / 2)
head-cy = next.head-y * cell-size + (cell-size / 2)
head-reach = cell-size * 0.46
perp-x = 0 - next.dir-y
perp-y = next.dir-x
tip-x = head-cx + next.dir-x * head-reach
tip-y = head-cy + next.dir-y * head-reach
back-x = head-cx - next.dir-x * head-reach
back-y = head-cy - next.dir-y * head-reach
triangle of tip-x, tip-y, (back-x + perp-x * head-reach), (back-y + perp-y * head-reach), (back-x - perp-x * head-reach), (back-y - perp-y * head-reach)

let score-size = 14 because "a deliberate size rather than the renderer's default: the score is a caption, and at the default sixteen it competed with the board"
size of score-size
fill of 0.15, 0, 0, 1
label of 8, 18, ("score: " + text of next.score)

if not next.alive:
  size of 20
  align of "center"
  fill of 0.42, 0.2, 25, 1
  label of (board-width / 2), (board-height / 2), "GAME OVER  -  press Reset to play again"
